// ── read_history:读 ~/.auto-shell-history(对齐 vue 版 worker.rs:633) ──
// 文件格式:每行一条命令(oldest first)。文件不存在 → File.read_text 返回空 → 空列表。
pub fn read_history() []str {
    var home str = Env.get("USERPROFILE")
    if home == "" {
        home = Env.get("HOME")
    }
    var path str = home + "/.auto-shell-history"
    var content str = File.read_text(path)
    var result List<str> = List<str>.new([])
    if content == "" {
        return result
    }
    var lines []str = content.split("\n")
    for line in lines {
        var trimmed str = line.trim()
        if trimmed != "" {
            result.push(trimmed)
        }
    }
    return result
}

// ── complete:基于 command_list 的 79 命令做前缀过滤 ──
// 对齐 vue 版 ash-core complete_from_signatures:sig.name.starts_with(prefix)。
// 取 line 首词作前缀,遍历 command_list().commands 过滤,最多 10 条。
// 空 line → 空列表(与 PromptBar .OnInput 的空输入清 suggestions 一致)。
pub fn complete(line str, cursor int) []CompletionItem {
    var items List<CompletionItem> = List<CompletionItem>.new([])
    var prefix str = line.trim()
    if prefix == "" {
        return items
    }
    // 取首词(命令名部分),忽略参数。
    var parts []str = prefix.split(" ")
    if parts.len() == 0 {
        return items
    }
    var cmd_prefix str = parts[0]
    var snap BootSnapshot = command_list()
    var count int = 0
    for c in snap.commands {
        if count >= 10 {
            break
        }
        if c.name.starts_with(cmd_prefix) {
            var item CompletionItem = CompletionItem{}
            item.replacement = c.name
            item.display = c.name
            item.description = c.description
            item.kind = "command"
            items.push(item)
            count = count + 1
        }
    }
    return items
}

// ── prompt_context:用 git 命令获取真实分支名 + status 统计 ──
// 对齐 vue 版 ash-core:git rev-parse 取分支,git status --porcelain 统计。
// 注:非 git 目录时 git 命令返回非零,unwrap 会 panic —— 调用方需确保在 git 仓库。
pub fn prompt_context() PromptContext {
    var pc PromptContext = PromptContext{}
    var branch_out = Command.new("git").args(["rev-parse", "--abbrev-ref", "HEAD"]).output().unwrap()
    var branch str = String.from_utf8(branch_out.stdout).unwrap()
    pc.git_branch = branch.trim()
    var gs GitStatusInfo = GitStatusInfo{}
    var status_out = Command.new("git").args(["status", "--porcelain"]).output().unwrap()
    var status_str str = String.from_utf8(status_out.stdout).unwrap()
    var lines []str = status_str.split("\n")
    var staged int = 0
    var unstaged int = 0
    var untracked int = 0
    var conflicted int = 0
    for line in lines {
        if line.len() >= 2 {
            var x str = line.substr(0, 1)
            var y str = line.substr(1, 1)
            if x == "?" && y == "?" {
                untracked = untracked + 1
            } else {
                if x != " " && x != "?" {
                    staged = staged + 1
                }
                if y != " " && y != "?" {
                    unstaged = unstaged + 1
                }
            }
        }
    }
    gs.staged = staged
    gs.unstaged = unstaged
    gs.untracked = untracked
    gs.conflicted = conflicted
    gs.ahead = 0
    gs.behind = 0
    pc.git_status = gs
    return pc
}

