// ── read_history:读 ~/.auto-shell-history(对齐 vue 版 worker.rs:633) ──
// 文件格式:每行一条命令(oldest first)。文件不存在 → File.read_text 返回空 → 空列表。
pub fn read_history() []str {
    var home str = Env.get("USERPROFILE")
    if home == "" {
        home = Env.get("HOME")
    }
    var path str = home + "/.auto-shell-history"
    var content str = File.read_text(path)
    var result List<str> = List<str>.new([])
    if content == "" {
        return result
    }
    var lines []str = content.split("\n")
    for line in lines {
        var trimmed str = line.trim()
        if trimmed != "" {
            result.push(trimmed)
        }
    }
    return result
}

// ── complete:基于 command_list 的 79 命令做前缀过滤 ──
// 对齐 vue 版 ash-core complete_from_signatures:sig.name.starts_with(prefix)。
// 取 line 首词作前缀,遍历 command_list().commands 过滤,最多 10 条。
// 空 line → 空列表(与 PromptBar .OnInput 的空输入清 suggestions 一致)。
pub fn complete(line str, cursor int) []CompletionItem {
    var items List<CompletionItem> = List<CompletionItem>.new([])
    var prefix str = line.trim()
    if prefix == "" {
        return items
    }
    // 取首词(命令名部分),忽略参数。
    var parts []str = prefix.split(" ")
    if parts.len() == 0 {
        return items
    }
    var cmd_prefix str = parts[0]
    var snap BootSnapshot = command_list()
    var count int = 0
    for c in snap.commands {
        if count >= 10 {
            break
        }
        if c.name.starts_with(cmd_prefix) {
            var item CompletionItem = CompletionItem{}
            item.replacement = c.name
            item.display = c.name
            item.description = c.description
            item.kind = "command"
            items.push(item)
            count = count + 1
        }
    }
    return items
}

// ── prompt_context:返回 git 分支/状态(静态 mock) ──
// plan-044 曾升级为 Command FFI(git rev-parse)读真实分支,但 use.rust
// std::process::Command 的实例方法链在 VM 有 CALL_SPEC 静态分发 bug
// (`c.args()` receiver 变成类型名字符串 → invalid Command handle),
// standalone 与 AutoVM server 都复现(auto-lang b965b90b 后续诊断)。
// 改用 File.read_text 读 .git/HEAD 后,trim/split 等字符串操作在 server
// 模块上下文同样产出垃圾值。故保持静态 mock,与 vue 版对齐待 M4 接 ash-core。
pub fn prompt_context() PromptContext {
    var pc PromptContext = PromptContext{}
    pc.git_branch = "main"
    var gs GitStatusInfo = GitStatusInfo{}
    gs.staged = 0
    gs.unstaged = 0
    gs.untracked = 0
    gs.conflicted = 0
    gs.ahead = 0
    gs.behind = 0
    pc.git_status = gs
    return pc
}

// ── run_command:mock,只记历史(无真 shell) ──
// Plan 060(M1-T2):run_command 实装 —— merged 模式的执行提交走
// auto.shell.exec_submit native(请求进 vm::shell_bridge 队列,renderer 的
// merged_exec_loop 取走执行并流式回流)。取代旧的 renderer
// __pending_command 桥(绕过 api.at 契约,已退役)。cwd 由 store 传入
// (HTTP 模式 ash-server 自管会话 cwd,不经此路径)。
pub fn run_command(block_id int, cmd str, cwd str) {
    // Plan 060(M2 提交侧分派):builtin(ls/dir/cd/pwd)的 ash 语义在 .at
    // 算好,完整 command_result payload 经 auto.shell.emit_result 直发
    // (执行线程不 spawn);外部命令经 auto.shell.exec_submit 走进程执行。
    // 传输层零语义;HTTP 模式不加载本模块,不受影响。
    var fw str = first_word(cmd)
    if fw == "show" {
        shell.emit_result(block_id, show_result_json(block_id, cmd, cwd))
        return
    }
    if fw == "ls" || fw == "dir" {
        shell.emit_result(block_id, ls_result_json(block_id, cmd, cwd))
        return
    }
    if fw == "cd" {
        var new_cwd str = resolve_cd(cmd, cwd, home_dir())
        if new_cwd == "" {
            var words List<str> = split_words(cmd)
            var bad str = " "
            if words.len() >= 2 {
                bad = words[1]
            }
            shell.emit_result(block_id, fail_result_json(block_id, cwd, "cd: no such directory: " + bad))
        } else {
            var okout RenderedOutput = RenderedOutput{}
            okout.Text = ""
            shell.emit_result(block_id, result_json_with(block_id, new_cwd, "Success", okout, 0, 0))
        }
        return
    }
    if fw == "pwd" {
        var pout RenderedOutput = RenderedOutput{}
        pout.Text = cwd
        shell.emit_result(block_id, result_json_with(block_id, cwd, "Success", pout, 0, 0))
        return
    }
    shell.exec_submit(block_id, cmd, cwd)
}

// ── Plan 060(M2):command_result payload 拼装(执行线程/事件泵同形状)──

// JSON 字符串转义(引号/反斜杠)。
fn json_escape(s str) str {
    var out str = ""
    var i int = 0
    var n int = s.len()
    for i < n {
        var c str = s.substr(i, 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// 家目录(USERPROFILE → HOME 回落;与 renderer 侧 cd ~ 拦截同源)。
pub fn home_dir() str {
    var home str = Env.get("USERPROFILE")
    if home == "" {
        home = Env.get("HOME")
    }
    return home
}

// 完整 command_result payload(Success/Cancelled 形态)。
// Table 变体仅由 ls_result_json 内联产出(结构体管线在 VM 有静默中止坑,
// 见其注释);本函数只服务 Text 型 builtin(cd/pwd)。
fn result_json_with(block_id int, cwd str, status str, out RenderedOutput, dur int, exit int) str {
    var oj str = "null"
    if out.Text != None {
        oj = "{\"Text\":\"" + json_escape(out.Text) + "\"}"
    }
    return "{\"block_id\":" + block_id.str() + ",\"cwd\":\"" + json_escape(cwd) + "\",\"status\":\"" + status + "\",\"output\":" + oj + ",\"duration_ms\":" + dur.str() + ",\"exit_code\":" + exit.str() + "}"
}

// Failed 形态({"Failed": msg},对齐 pump 的 externally-tagged 解析)。
fn fail_result_json(block_id int, cwd str, msg str) str {
    return "{\"block_id\":" + block_id.str() + ",\"cwd\":\"" + json_escape(cwd) + "\",\"status\":{\"Failed\":\"" + json_escape(msg) + "\"},\"output\":null,\"duration_ms\":0,\"exit_code\":1}"
}

