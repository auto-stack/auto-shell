// back/api.at — ash-gui Shell API 接口定义
// Plan 043 M1: 反向生成自 ash-server 的 HTTP 端点 + ash-gui-vue 的 types/shell.ts
//
// 这些 #[api] 函数定义了前后端之间的契约。auto-lang codegen 会从这份文件生成:
//   - TypeScript client (api.ts): fetch 调用,浏览器版用
//   - Axum routes (Rust): HTTP 端点,ash-server 用
//   - Tauri commands (Rust): Tauri IPC,Tauri 版用
//
// 业务逻辑(Shell 执行、补全引擎等)在 auto-shell/ash-core 里,不在此文件。

use types: BootSnapshot, CompletionItem, PromptContext, ShellEvent, SmartResult

// ═══════════════════════════════════════════════════════════
// API 类型定义(codegen 从这里生成 TS interface + Rust struct)
// Plan 043 M5:这些类型原只在 front/types.at(纯前端,api codegen 不读),
// 导致生成的 api.ts 引用了未定义的类型名。复制到这里作为 pub type。
// ═══════════════════════════════════════════════════════════


pub type CodeSpan = {
    text: str
    r: int
    g: int
    b: int
    bold: bool
    italic: bool
}

// RenderedOutput 是 Rust 枚举,serde 用变体名作键(tagged union):
//   {"Table":{columns,rows}} | {"Text":"..."} | {"Code":{lines,language}}
//   | {"Error":{message}} | {"Record":{...}}
// 字段用 ?T(可选)表达"仅一个变体存在"。前端用 `if .output.Table != None`
// 分发并窄化类型。RenderedCell 同理:{"Text":"..."} | {"Tagged":{text,tag}}。
pub type TaggedCell = {
    text: str
    tag: str
    kind: str
}

pub type RenderedCell = {
    Text: ?str
    Tagged: ?TaggedCell
}

pub type TableOutput = {
    columns: []str
    rows [][]RenderedCell
}

pub type CodeOutput = {
    lines [][]CodeSpan
    language: str
}

pub type ErrorOutput = {
    message: str
}

/// Record 变体:key/value 字段列表 + atom_type(语义标签,如 MemoryInfo)。
/// fields 是 (key, cell) 元组数组,服务端 serde 发 `[["key", cell], ...]`。
pub type RecordOutput = {
    fields: [](str, RenderedCell)
    atom_type: str
}

pub type RenderedOutput = {
    Table: ?TableOutput
    Text: ?str
    Code: ?CodeOutput
    Error: ?ErrorOutput
    Record: ?RecordOutput
}

pub type BlockStatus = {
    kind: str
    message: str
}

pub type Block = {
    id: int
    command: str
    cwd: str
    status: BlockStatus
    output: RenderedOutput
    streamed_text: str
    duration_ms: int
}

pub type GitStatusInfo = {
    staged: int
    unstaged: int
    untracked: int
    conflicted: int
    ahead: int
    behind: int
}

pub type PromptContext = {
    git_branch: str
    git_status: GitStatusInfo
}

pub type CompletionItem = {
    replacement: str
    display: str
    description: str
    kind: str
}

// SmartCommand 结果:服务端 /api/run_smart 返回**裸 JSON 字符串**
// (ash-server http.rs::run_smart → `Json(result.output)`,output 是 String),
// 不是结构体。故 run_smart 返回类型直接用 str(无 SmartResult 类型别名——
// lenient 提取对 `pub type X = str` 别名不生成 interface,会导致 run_smart 的
// Promise<SmartResult> 引用未定义)。

/// 命令最终结果(command-result 事件)。
/// 服务端 CommandStatus 是 serde externally-tagged 枚举:
///   Success → "Success"(裸字符串),Failed(msg) → {"Failed": msg}(对象)。
/// .at 无法直接表达 string|object 联合,这里用 `status: str`(codegen 擦除成 any),
/// store RunResult 按运行时形状判断:`result.status == "Success"` 走成功分支,
/// 否则 `result.status.Failed` 取失败消息(JS 动态派发,store 全 any)。
pub type CommandResult = {
    block_id: int
    cwd: str
    status: str
    output: RenderedOutput
    duration_ms: int
}

pub type ShellEvent = {
    event: str
    block_id: int
    chunk: str
    result: CommandResult
}

pub type ToolEntry = {
    name: str
    description: str
    usage: str
}

pub type SmartCommandEntry = {
    name: str
    description: str
    args: []str
}

pub type BootSnapshot = {
    cwd: str
    home: str
    commands []ToolEntry
    smart_commands []SmartCommandEntry
}

// ═══════════════════════════════════════════════════════════
// Request-Response 端点
// ═══════════════════════════════════════════════════════════

/// 启动数据:cwd + 命令列表 + SmartCommands
/// GET /api/command_list
#[api(method = "GET", path = "/api/command_list")]
pub fn command_list() BootSnapshot {
    return shell.command_list()
}

/// 读取共享 CLI 历史文件
/// GET /api/history
#[api(method = "GET", path = "/api/history")]
pub fn history() []str {
    return shell.read_history()
}

/// 补全候选(共享补全引擎,Plan 041 M7)
/// POST /api/complete
#[api(method = "POST", path = "/api/complete")]
pub fn complete(line str, cursor int) []CompletionItem {
    return shell.complete(line, cursor)
}

/// Prompt 上下文(git 分支/状态,Plan 041 M5)
/// GET /api/prompt_context
#[api(method = "GET", path = "/api/prompt_context")]
pub fn prompt_context() PromptContext {
    return shell.prompt_context()
}

/// 执行命令(非阻塞——结果通过 /api/stream 的 SSE 推送)
/// POST /api/run_command
#[api(method = "POST", path = "/api/run_command")]
pub fn run_command(block_id int, cmd str) {
    shell.run_command(block_id, cmd)
}

/// 执行 SmartCommand(同步返回结果)
/// POST /api/run_smart
/// 返回裸文本(Json(result.output)),前端 response.json() 得字符串。
#[api(method = "POST", path = "/api/run_smart")]
pub fn run_smart(block_id int, name str, args []str) str {
    return shell.run_smart(block_id, name, args)
}

/// 取消当前运行的命令
/// POST /api/cancel
#[api(method = "POST", path = "/api/cancel")]
pub fn cancel() {
    shell.cancel()
}

/// 用 OS 默认程序打开路径
/// POST /api/open_path
#[api(method = "POST", path = "/api/open_path")]
pub fn open_path(path str) {
    shell.open_path(path)
}

// ═══════════════════════════════════════════════════════════
// 流式端点(SSE)
// ═══════════════════════════════════════════════════════════

/// 订阅 Shell 事件流(command-output + command-result)
/// 浏览器版用 EventSource;Tauri 版用 listen()。
///
/// `~Stream<ShellEvent>` 是**类型驱动 SSE codegen** 的契约(Plan 043 stream phase):
/// auto-lang 从这个返回类型 + `#[api(path=...)]` 自动在前端 store composable 注入
/// `EventSource('/api/stream')` 并把每条 SSE 消息按 `data.event` 判别派发到
/// `RunOutput`/`RunResult` action。api.ts 里不再生成(永不调用的)`stream()` fetch fn。
/// GET /api/stream
#[api(method = "GET", path = "/api/stream")]
pub fn stream() ~Stream<ShellEvent> {
    return shell.subscribe()
}
