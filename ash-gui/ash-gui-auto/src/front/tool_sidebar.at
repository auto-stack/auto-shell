// front/tool_sidebar.at — 左侧工具栏 widget
// Plan 043 M4: 反向生成自 ToolSidebar.vue
//
// 列出所有可用命令,点击注入输入框。
// Plan 066(模式减法):SmartCommands 分区撤除 —— smart 不再是 GUI 的独立
// 入口,未来以 AI 模式内的 skill 形态回归时另立设计(见 docs/plans/066)。

use types: ToolEntry

widget ToolSidebar(commands: List<ToolEntry>, on_pick: msg) {
    msg Msg { Pick(str) }

    view {
        scroll {
            style: "w-56 shrink-0 border-r border-border bg-card/30"

            // Commands 标题
            text "Commands" {
                style: "px-3 py-2 text-[11px] font-semibold text-muted-foreground uppercase tracking-wide"
            }

            // 命令列表
            col {
                style: "px-1.5 gap-0.5"
                for c in .commands {
                    button .c.name {
                        onclick: .Pick(.c.name)
                        style: "w-full bg-transparent !justify-start !items-baseline text-left px-2 py-1 rounded text-xs font-mono-ash text-sky-300/90 hover:bg-white/10 hover:text-sky-200"
                        if .c.description != "" {
                            text .c.description {
                                style: "truncate text-[10px] text-muted-foreground/70"
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Pick(name) -> { }
    }
}
