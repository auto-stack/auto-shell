// front/types.at — ash-gui 前端类型定义
// Plan 043 M1: 反向生成自 ash-gui-vue/src/types/shell.ts
//
// 这些类型镜像 ash-core 的 RenderedOutput 家族 + ash-gui 的 Block/事件 payload。
// 后端的 pub type 定义在 back/api.at(共享);这里放前端专用的组合类型。

// ═══════════════════════════════════════════════════════════
// 类型别名
// ═══════════════════════════════════════════════════════════

alias AtomType = str
alias FileNameKind = str
alias CellTag = str
alias RenderErrorKind = str

// ═══════════════════════════════════════════════════════════
// 渲染输出(RenderedOutput 家族)
// ═══════════════════════════════════════════════════════════

/// 代码高亮的一个着色片段(Plan 042 M6 B1)
type CodeSpan {
    text str
    r int
    g int
    b int
    bold bool
    italic bool
}

/// 输入框语法高亮的一个着色片段(Plan 053 M3;Plan 053 后续逻辑可移植化)。
/// text=token 文本; kind=**语义 token 类型**(非 CSS 色串),取值:
/// Command / ExternalCmd / String / Variable / Operator / Redirect /
/// Comment / Flag / Whitespace / Arg。
/// 逻辑层只产 kind(target-neutral,vue/VM 都跑);各 target 在渲染层按 kind 查色
/// (vue:视图 span if-chain → inline CSS;VM:iced renderer kind→RGB)。
type HighlightSpan {
    text str
    kind str
}

/// 渲染单元格:纯文本 或 带标签的文本
type RenderedCell {
    text str
    tag CellTag
}

// NOTE(2026-08-06):本文件曾有一份过时的扁平 `RenderedOutput` 定义
// (带 `kind str` + `List<List<T>>` 写法),已被 `back/api.at` 的 variant-keyed
// 定义取代(`Table: ?TableOutput` 等,`[][]T` lenient 提取已支持)。已删除。
// RenderedOutput / TableOutput / CodeOutput / ErrorOutput / RecordOutput /
// RenderedCell / TaggedCell / CodeSpan 的**权威定义**都在 `back/api.at`。
// 本文件保留下方的组合类型(Block/事件 payload 等)供前端文档参考。

// ═══════════════════════════════════════════════════════════
// Block 生命周期
// ═══════════════════════════════════════════════════════════

/// Block 状态
type BlockStatus {
    kind str
    message str
}

/// 一个命令块(前端跟踪的最小单元)
type Block {
    id int
    command str
    cwd str
    status BlockStatus
    output RenderedOutput
    streamed_text str
    duration_ms int
    // Plan 054 M2: 子进程退出码(对齐 CLI $?)。
    exit_code int
    // Plan 055 D5: 折叠状态移到 block 数据(per-block,避免 VM 单根 state
    // 合并导致点一个全折叠;vue 模式每实例本就独立,此字段两者统一)。
    collapsed bool
    // Plan 063 T2:AI 建议分步 + 每步样式(前端本地;api.at 的 Block 契约
    // 是本体,这里同步供前端文档参考)。
    steps []str
    step_styles []str
    // Plan 063 T5:chat 回合号(`??` 第 N 次提问;ai_turn 事件写入,块头
    // 横幅"· 第 N 轮"渲染。非 chat 块恒 0。
    turn int
}

/// Plan 055 Phase A: 后台作业信息(作业控制 `cmd &`)。
type JobInfo {
    id int
    command str
    state str
    exit_code int
}

// ═══════════════════════════════════════════════════════════
// 事件 payload
// ═══════════════════════════════════════════════════════════

/// 命令最终结果(command-result 事件)
type CommandResult {
    block_id int
    cwd str
    status str
    failed_message str
    output RenderedOutput
    duration_ms int
}

/// 流式输出块(command-output 事件)
type CommandOutput {
    block_id int
    chunk str
}

/// Plan 063 T4:AI chat 抽屉的一行(kind 决定渲染样式)。
/// kind: turn(── 第 N 轮 ── 分隔线)| user(提问)| text(回答增量)
///      | tool(⚙ 工具调用)| result(← 工具结果)| sys(系统提示)。
type ChatEvent {
    kind str
    text str
}

/// Shell 事件(SSE 流推送的 union)
type ShellEvent {
    event str
    block_id int
    chunk str
    result CommandResult
}

// ═══════════════════════════════════════════════════════════
// Boot 数据 + 补全 + Prompt 上下文
// ═══════════════════════════════════════════════════════════

/// 工具栏命令条目
type ToolEntry {
    name str
    description str
}

/// SmartCommand 条目
type SmartCommandEntry {
    name str
    description str
}

/// 启动快照(command_list 返回)
type BootSnapshot {
    cwd str
    home str
    commands []ToolEntry
    smart_commands []SmartCommandEntry
}

/// 补全候选
type CompletionItem {
    replacement str
    display str
    description str
    kind str
}

/// Git 状态摘要
type GitStatusInfo {
    staged int
    unstaged int
    untracked int
    conflicted int
    ahead int
    behind int
}

/// Prompt 上下文(git 分支/状态)
type PromptContext {
    git_branch str
    git_status GitStatusInfo
}

/// SmartCommand 执行结果
type SmartResult {
    output str
    error str
}
