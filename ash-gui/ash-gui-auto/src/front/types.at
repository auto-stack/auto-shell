// front/types.at — ash-gui 前端类型定义
// Plan 043 M1: 反向生成自 ash-gui-vue/src/types/shell.ts
//
// 这些类型镜像 ash-core 的 RenderedOutput 家族 + ash-gui 的 Block/事件 payload。
// 后端的 pub type 定义在 back/api.at(共享);这里放前端专用的组合类型。

// ═══════════════════════════════════════════════════════════
// 类型别名
// ═══════════════════════════════════════════════════════════

alias AtomType = str
alias FileNameKind = str
alias CellTag = str
alias RenderErrorKind = str

// ═══════════════════════════════════════════════════════════
// 渲染输出(RenderedOutput 家族)
// ═══════════════════════════════════════════════════════════

/// 代码高亮的一个着色片段(Plan 042 M6 B1)
type CodeSpan {
    text str
    r int
    g int
    b int
    bold bool
    italic bool
}

/// 输入框语法高亮的一个着色片段(Plan 053 M3)
/// text=token 文本, color=inline CSS(如 "color:#34d399;font-weight:bold")。
/// 用 inline CSS 而非 Tailwind class: .at codegen 的动态 class 拼接走 :style
/// (非 :class), inline CSS 正好适配; Tailwind 动态 :class 是 codegen 限制(P5-7)。
type HighlightSpan {
    text str
    color str
}

/// 渲染单元格:纯文本 或 带标签的文本
type RenderedCell {
    text str
    tag CellTag
}

// NOTE(2026-08-06):本文件曾有一份过时的扁平 `RenderedOutput` 定义
// (带 `kind str` + `List<List<T>>` 写法),已被 `back/api.at` 的 variant-keyed
// 定义取代(`Table: ?TableOutput` 等,`[][]T` lenient 提取已支持)。已删除。
// RenderedOutput / TableOutput / CodeOutput / ErrorOutput / RecordOutput /
// RenderedCell / TaggedCell / CodeSpan 的**权威定义**都在 `back/api.at`。
// 本文件保留下方的组合类型(Block/事件 payload 等)供前端文档参考。

// ═══════════════════════════════════════════════════════════
// Block 生命周期
// ═══════════════════════════════════════════════════════════

/// Block 状态
type BlockStatus {
    kind str
    message str
}

/// 一个命令块(前端跟踪的最小单元)
type Block {
    id int
    command str
    cwd str
    status BlockStatus
    output RenderedOutput
    streamed_text str
    duration_ms int
}

// ═══════════════════════════════════════════════════════════
// 事件 payload
// ═══════════════════════════════════════════════════════════

/// 命令最终结果(command-result 事件)
type CommandResult {
    block_id int
    cwd str
    status str
    failed_message str
    output RenderedOutput
    duration_ms int
}

/// 流式输出块(command-output 事件)
type CommandOutput {
    block_id int
    chunk str
}

/// Shell 事件(SSE 流推送的 union)
type ShellEvent {
    event str
    block_id int
    chunk str
    result CommandResult
}

// ═══════════════════════════════════════════════════════════
// Boot 数据 + 补全 + Prompt 上下文
// ═══════════════════════════════════════════════════════════

/// 工具栏命令条目
type ToolEntry {
    name str
    description str
}

/// SmartCommand 条目
type SmartCommandEntry {
    name str
    description str
}

/// 启动快照(command_list 返回)
type BootSnapshot {
    cwd str
    home str
    commands []ToolEntry
    smart_commands []SmartCommandEntry
}

/// 补全候选
type CompletionItem {
    replacement str
    display str
    description str
    kind str
}

/// Git 状态摘要
type GitStatusInfo {
    staged int
    unstaged int
    untracked int
    conflicted int
    ahead int
    behind int
}

/// Prompt 上下文(git 分支/状态)
type PromptContext {
    git_branch str
    git_status GitStatusInfo
}

/// SmartCommand 执行结果
type SmartResult {
    output str
    error str
}
