// front/prompt_bar.at — 命令输入栏 widget
// Plan 043 M3: 反向生成自 PromptBar.vue
//
// 底部输入栏:补全建议行 + ❯ prompt + cwd + 输入框(ghost text + 语法高亮)。
// 支持:↑↓ 历史、Ctrl+R 搜索、Ctrl+F 接受建议、Tab 补全、多行续行。

use shell_store: ShellStore
use history_search: HistorySearch
use back.api: complete
use types: CompletionItem, HighlightSpan

widget PromptBar(cwd: str, home: str, command_names: []str, history: []str, injected_command: str, on_run: msg, on_injected: msg, on_clear: msg, on_exit: msg) {
    msg Msg { Run(str), Injected, Clear, Exit,
              HistoryOlder, HistoryNewer,
              PickCompletion(CompletionItem),
              ToggleHistorySearch,
              AcceptGhost, AcceptGhostWord, OnCtrlL, DoTokenize,
              OnEnter(str), DoContinuation }

    computed {
        // Plan 053 后续:pwd 仅在顶端标题栏(app.at)显示,输入框不再显示 cwd,
        // 故本 widget 不再需要 cwd_display(home/cwd props 保留,签名不动)。
        // Plan 053 M4: prompt 符号 — 续行时 `·`,正常 `❯`(对齐 repl.rs:913)。
        prompt_symbol => if .in_continuation { "·" } else { "❯" }
    }

    model {
        var input str = ""
        var history_cursor int = -1
        var in_continuation bool = false
        var history_open bool = false
        var suggestions []CompletionItem = []
        var ghost_text str = ""
        var highlighted_spans []HighlightSpan = []
        // Plan 053 后续:Tab 循环补全状态。tab_active=正在 Tab 循环;tab_candidates=
        // 进入循环时缓存的候选(循环期间 input 已被补全、.suggestions 会变,故另存);
        // tab_index=当前选中下标;tab_just_completed=标记"本次 input 变化是 Tab 触发的",
        // 让紧跟的 keyup(OnInput)不要误判为用户输入而结束循环。
        var tab_active bool = false
        var tab_index int = 0
        var tab_candidates []CompletionItem = []
        var tab_just_completed bool = false
    }

    // 侧栏点击工具 → 填入输入框(原生 PromptBar 的 injectedCommand watch)
    watch {
        .injected_command -> {
            if .injected_command != "" {
                .input = .injected_command
                .history_cursor = -1
                .suggestions = []
                .history_open = false
            }
        }
    }

    // expose .Exit:保留(P5-7 的 mark_self_called_handlers 已能自动识别
    // handler 间自调用, .Exit/.DoTokenize 无需 expose 也能生成 function;
    // 这里保留 .Exit expose 兼容旧 codegen,无害)。
    expose {
        .Exit
    }

    // props: cwd str, home str, command_names []str,
    //        history []str, injected_command str,
    //        on_run: msg, on_injected: msg, on_clear: msg, on_exit: msg

    view {
        col {
            style: "border-t border-border bg-background/80 px-3 py-2 gap-1"

            // 补全建议行(Plan 041 M7)
            if .suggestions.len() > 0 {
                row {
                    style: "flex-wrap gap-1.5"
                    for s in .suggestions {
                        button .s.display {
                            onclick: .PickCompletion(.s)
                            style: "text-xs font-mono-ash px-2 py-0.5 rounded bg-muted/60 hover:bg-muted text-sky-300"
                            // PB-comp-07:显示 description(灰色小字)。
                            if .s.description != "" {
                                text .s.description {
                                    style: "text-[10px] text-muted-foreground/70"
                                }
                            }
                        }
                    }
                }
            }

            // 输入行:❯ + textarea(Plan 053 后续:pwd 仅留顶端标题栏,此行不再显示)。
            // 行用单一静态 style(gap-2 给 ❯ 与输入 8px 间距);续行颜色挪到
            // prompt_symbol —— 旧 .at 两 style 合一 + row 动态 class 缺失致 gap 丢失。
            row {
                style: "relative items-center gap-2"

                // 历史搜索弹层
                HistorySearch(
                    history: .history,
                    open: .history_open,
                    on_run: .Run,
                    on_close: .ToggleHistorySearch
                )

                text .prompt_symbol {
                    // Plan 053 后续:与上方高亮 span 同款约定 —— style: If 三元经
                    // codegen 走 Vue :class(类名有效);Tailwind 色类经共享
                    // color.rs 调色板同时落 vue(CSS) 与 VM(iced RGB)。
                    style: if .in_continuation { "font-mono-ash select-none shrink-0 text-amber-400" } else { "font-mono-ash select-none shrink-0 text-emerald-500" }
                }

                // Plan 057 续(富文本输入):语法高亮 + ghost 建议不再用
                // 「透明文字 + 绝对定位叠加层」(vue CSS 手法,VM 下光标透明/
                // 对齐/焦点一串债),改为 textarea 原生能力 —— highlight 传入
                // DoTokenize 产出的 (text, kind) 连续段,ghost 传灰色建议后缀。
                // VM 端:着色走 iced 原生 Highlighter,ghost 嵌入内容自动剥离;
                // Vue 端:codegen 据此生成叠加层(手法下沉为生成器职责)。
                textarea {
                    value: .input
                    highlight: .highlighted_spans
                    ghost: .ghost_text
                    oninput: .OnInputComplete(.input)
                    onkeyup: .OnInput
                    onenter: .OnEnter(.input)
                    onkeydown.ctrl.r: .ToggleHistorySearch
                    // Plan 053 M2: Ctrl+F 接受全部 ghost text,Ctrl+→ 接受一个词。
                    onkeydown.ctrl.f: .AcceptGhost
                    onkeydown.ctrl.right: .AcceptGhostWord
                    // PB-11:Ctrl+L 清屏(归档 blocks),非清输入。绑 OnCtrlL,
                    // renderer emit 模拟转发到 store.ClearScreen(vm 剥离 callback emit)。
                    onkeydown.ctrl.l: .OnCtrlL
                    onkeydown.ctrl.d: .OnCtrlD
                    onkeydown.ctrl.c: .OnCtrlC
                    onkeydown.up: .HistoryOlder
                    onkeydown.down: .HistoryNewer
                    onkeydown.tab.prevent: .OnTab
                    // Plan 057 续:ghost 显示时右箭头逐字接受(fish 语义,接受过的
                    // 字符即变实色);ghost 为空时 VM 端不拦截(默认光标移动),
                    // Vue 端默认移动本就无 ghost 可走。不加 .prevent —— Vue 需要
                    // 默认行为兜底,VM 由 renderer 按 ghost 状态门控。
                    onkeydown.right: .OnRight
                    rows: 1
                    style: "w-full bg-transparent outline-none border-0 px-0 text-sm font-mono-ash resize-none max-h-[168px] overflow-y-auto [field-sizing:content]"
                    placeholder: "type a command…"
                }
            }
        }
    }

    on {
        // Plan 053 M3 / 后续(逻辑可移植化):重新 tokenize .input 写 highlighted_spans。
        // 内联 tokenize:widget 文件的顶层 module fn 不被 codegen,store 的 module fn
        // 又不能被 widget use 导入,故状态机直接写在 handler 里。用 break(支持)代替
        // continue(不支持)。状态机逻辑不变;只把产出从「inline CSS 色串」改成「语义 kind」
        // (Command/ExternalCmd/String/Variable/Operator/Redirect/Comment/Flag/Whitespace/
        // Arg)→ 逻辑层 target-neutral。各 target 的 kind→色 渲染在视图层 span if-chain。
        .DoTokenize -> {
            var spans []HighlightSpan = []
            var line str = .input
            var n int = line.len()
            var i int = 0
            var first_word bool = true
            var idc str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
            var builtins str = " cd ls l echo cat grep mkdir rm cp mv touch find glob stat du file tee ln head tail sort uniq wc cut tr split rev column diff select get where update insert each build run http_get http_post http_put http_delete pwd help clear exit quit q set export unset use alias unalias source history ps sys which version up u b less more color completions config bind abbr hook def pushd popd dirs env date sleep "
            for i < n {
                var c str = line.substr(i, i + 1)
                if c == "#" && (i == 0 || line.substr(i - 1, i) == " " || line.substr(i - 1, i) == "\t") {
                    spans.push(HighlightSpan{text: line.substr(i, n), kind: "Comment"})
                    break
                } else if c == " " || c == "\t" {
                    var j int = i
                    for j < n {
                        var cj str = line.substr(j, j + 1)
                        if cj == " " || cj == "\t" { j = j + 1 } else { break }
                    }
                    spans.push(HighlightSpan{text: line.substr(i, j), kind: "Whitespace"})
                    i = j
                    first_word = false
                } else if c == "\"" || c == "'" {
                    var quote str = c
                    var j int = i + 1
                    for j < n {
                        if line.substr(j, j + 1) != quote {
                            if quote == "\"" && line.substr(j, j + 1) == "\\" && j + 1 < n { j = j + 1 }
                            j = j + 1
                        } else { break }
                    }
                    var e int = j + 1
                    if e > n { e = n }
                    spans.push(HighlightSpan{text: line.substr(i, e), kind: "String"})
                    i = e
                    first_word = false
                } else if c == "$" {
                    var j int = i + 1
                    if j < n && line.substr(j, j + 1) == "{" {
                        for j < n {
                            if line.substr(j, j + 1) != "}" { j = j + 1 } else { break }
                        }
                        var e int = j + 1
                        if e > n { e = n }
                        spans.push(HighlightSpan{text: line.substr(i, e), kind: "Variable"})
                        i = e
                    } else {
                        for j < n {
                            if idc.contains(line.substr(j, j + 1)) { j = j + 1 } else { break }
                        }
                        spans.push(HighlightSpan{text: line.substr(i, j), kind: "Variable"})
                        i = j
                    }
                    first_word = false
                } else if c == "|" || c == ";" || (c == "&" && i + 1 < n && line.substr(i + 1, i + 2) == "&") {
                    var ol int = 1
                    if c == "|" && i + 1 < n && line.substr(i + 1, i + 2) == "|" { ol = 2 }
                    if c == "&" { ol = 2 }
                    var e int = i + ol
                    if e > n { e = n }
                    spans.push(HighlightSpan{text: line.substr(i, e), kind: "Operator"})
                    i = e
                    first_word = true
                } else if c == ">" || c == "<" {
                    var rl int = 1
                    if c == ">" && i + 1 < n && line.substr(i + 1, i + 2) == ">" { rl = 2 }
                    var e int = i + rl
                    if e > n { e = n }
                    spans.push(HighlightSpan{text: line.substr(i, e), kind: "Redirect"})
                    i = e
                    first_word = false
                } else {
                    var j int = i
                    for j < n {
                        var cj str = line.substr(j, j + 1)
                        if cj == " " || cj == "\t" || cj == "\"" || cj == "'" || cj == "$" || cj == "|" || cj == "&" || cj == ";" || cj == "#" || cj == ">" || cj == "<" { break }
                        j = j + 1
                    }
                    var word str = line.substr(i, j)
                    if first_word {
                        if builtins.contains(" " + word + " ") {
                            spans.push(HighlightSpan{text: word, kind: "Command"})
                        } else {
                            spans.push(HighlightSpan{text: word, kind: "ExternalCmd"})
                        }
                        first_word = false
                    } else {
                        if word.starts_with("-") && word.len() > 1 {
                            spans.push(HighlightSpan{text: word, kind: "Flag"})
                        } else {
                            spans.push(HighlightSpan{text: word, kind: "Arg"})
                        }
                    }
                    i = j
                }
            }
            .highlighted_spans = spans
        }

        // 纯转发:清状态后由自动 emit('Run', cmd) 发给父级(App.RunCommand 执行)
        .Run(cmd) -> {
            .input = ""
            .history_cursor = -1
            .suggestions = []
            .highlighted_spans = []
            .in_continuation = false
        }

        // Plan 053 M5/P5-6: 输入变化的「立即部分」(ghost text + tokenize +
        // 续行)绑 onkeyup。后端补全(complete)拆到 .OnInputComplete(下),
        // 绑 oninput 走 codegen 注入的 80ms debounce + 序列号守卫 —— 避免
        // 每次 keyup 打后端,且过期结果不覆盖最新建议。
        .OnInput -> {
            // Plan 053 后续:Tab 循环补全状态机。Tab 补全会改 .input,紧接着 Tab 的
            // keyup 也走本 handler —— 用 tab_just_completed 区分:是 Tab 触发的就只清
            // 标记、把候选列表恢复成缓存的 tab_candidates(保持循环期间稳定),并跳过
            // ghost/补全重算(否则补全到的全名会再触发一次 complete,候选行就空了);
            // 否则若 tab_active,说明用户输入了字符 → 结束循环。
            if .tab_just_completed {
                .tab_just_completed = false
                .ghost_text = ""
                .suggestions = .tab_candidates
                // 重新 tokenize + 续行检测:Tab 补全改了 .input,必须更新 highlighted_spans
                // —— 输入框可见文字靠 overlay 渲染 spans(textarea 文字透明),不重算
                // spans 的话补全进去的字(如 Cargo.lock)在 overlay 里仍是旧 input,看不见。
                .DoTokenize()
                .DoContinuation()
            } else {
                if .tab_active {
                    .tab_active = false
                    .tab_candidates = []
                }
                // Plan 053 M2: ghost text = 以当前输入为前缀的最长历史条目
                // (去掉已输入前缀,只留建议续接)。对齐 vue 原版 PromptBar.vue:299-328。
                .ghost_text = ""
                if .input != "" {
                    var best_ghost str = ""
                    var i int = .history.len() - 1
                    for i >= 0 {
                        var h str = .history[i]
                        if h.starts_with(.input) && h.len() > .input.len() {
                            var g str = h.substr(.input.len(), h.len())
                            if g.len() > best_ghost.len() {
                                best_ghost = g
                            }
                        }
                        i = i - 1
                    }
                    .ghost_text = best_ghost
                }
                // Plan 053 M3: 重新 tokenize 写 highlighted_spans。
                .DoTokenize()
                // Plan 053 M4: 续行标志(未闭合分隔符/引号/尾随 \)→ prompt 符号 + Enter 行为。
                .DoContinuation()
                // Plan 053 M5: 兜底触发补全(vue 端 OnInputComplete 自带 80ms debounce)。
                .OnInputComplete()
            }
        }

        // Plan 053 M5/P5-6: 后端补全(complete)独立 handler,绑 oninput。
        // .at 无定时器(native_catalog 全表无 setTimeout/debounce),debounce
        // 由 vue codegen 识别「body 含 complete 调用」自动注入:整个 body 包
        // setTimeout(80ms) + __completeSeq 序列号;state-ref 赋值(.suggestions=)
        // 加 if(__seq===__completeSeq) 守卫,丢弃过期结果(对齐 vue 原版
        // PromptBar.vue:60-84 的 completeTimer/completeSeq)。
        // VM 模式无 setTimeout,本 handler 同步执行 complete(与拆分前等价)。
        // 注意:此处**不要**调用 .DoTokenize() —— handler 内嵌套调用 sibling
        // handler 会破坏 VM 调用帧(new_sp 下溢 panic,exit 101),高亮 spans
        // 也会乱序(输入 ls 显示 sl)。真实键入走 keyup→.OnInput 的 DoTokenize。
                // Plan 057 (Bug 1 复查结论):complete 的 body 参数走与普通位置
                // 相同的 compile_expr,无独立编码缺陷;此前观察到的
                // complete(0,1) 是 Bug 2(.history 读中止+legacy 重试污染调用
                // 帧)修复前的连环污染。fake-backend 契约测试已复核
                // complete(.input, .input.len()) 发出 {"line":"ec","cursor":2}。
        // Plan 057 (2.3): per-keystroke 管线整合(tokenize + 续行 + 补全)。
        // 背景:iced text_editor 只有 on_action/on_change 通道,**无 keyup**,
        // 故 .OnInput(绑 onkeyup)在 VM 从不触发 —— tokenize/续行原先住在
        // OnInput 里,VM 下是死路;实测 sibling 调用(RET 下溢保护后)已可从
        // 本 handler 调 .DoTokenize()/.DoContinuation()。
                // ghost text:Plan 057 (Bug 2 修复)后双端可用 —— 数组 prop
                // (.history)经 ensure_child_state 转堆 ListData 存储,handler 内
                // 读取不再静默中止;List.len native 已补。
                // vue 端:OnInput(keyup)即时跑 ghost/tokenize,本 handler 80ms debounce
                // 重复 tokenize —— 幂等。
        .OnInputComplete(v str) -> {
            if .tab_just_completed {
                .tab_just_completed = false
            } else {
                if .tab_active {
                    .tab_active = false
                    .tab_candidates = []
                }
                // ghost text = 以当前输入为前缀的最长历史条目(Plan 053 M2)。
                // Plan 057 (Bug 2 修复):数组 prop(.history)经 ensure_child_state
                // 转堆 ListData 存储,handler 内读取不再静默中止 —— ghost 从
                // vue-only 恢复为双端。ghost 匹配用参数 v(派发时快照,与
                // complete 的 .input 现读等价,均经契约测试验证)。
                .ghost_text = ""
                if v != "" {
                    var best_ghost str = ""
                    var gi int = .history.len() - 1
                    for gi >= 0 {
                        var gh str = .history[gi]
                        if gh.starts_with(v) && gh.len() > v.len() {
                            var gg str = gh.substr(v.len(), gh.len())
                            if gg.len() > best_ghost.len() {
                                best_ghost = gg
                            }
                        }
                        gi = gi - 1
                    }
                    .ghost_text = best_ghost
                }
                .DoTokenize()
                .DoContinuation()
            }
            if v.trim() != "" {
                .suggestions = complete(.input, .input.len())
            } else {
                .suggestions = []
            }
        }

        // Plan 053 M4: 续行检测 — 未闭合 { } ( ) [ ] / 引号 / 尾随 \ 时置
        // .in_continuation = true。逻辑照搬 vue 原版 needsContinuation
        // (mirrors repl_mode.rs:96)。纯字符串分析,无后端往返,prompt 即时切换。
        // widget 顶层 module fn 不被 codegen(与 M3 DoTokenize 同款限制),故内联。
        .DoContinuation -> {
            var txt str = .input + "\n"
            var trimmed str = txt.trim()
            var needs bool = false
            if trimmed != "" {
                if trimmed.ends_with("\\") {
                    needs = true
                } else {
                    var brace int = 0
                    var paren int = 0
                    var bracket int = 0
                    var in_single bool = false
                    var in_double bool = false
                    var i int = 0
                    for i < trimmed.len() {
                        // 用 substr(i, i+1) 取单字符:char_at 在 VM 返回 int
                        // codepoint(Plan 368 W5),vue 返回 string,两 target
                        // 语义不一致;substr 两边都返回 string(M4 续行检测)。
                        var c str = trimmed.substr(i, i + 1)
                        // 双引号内的转义字符跳过(\\" 不结束字符串)
                        if in_double && c == "\\" && i + 1 < trimmed.len() {
                            i = i + 1
                        } else if c == "'" {
                            if !in_double { in_single = !in_single }
                        } else if c == "\"" {
                            if !in_single { in_double = !in_double }
                        } else if c == "{" {
                            if !in_single && !in_double { brace = brace + 1 }
                        } else if c == "}" {
                            if !in_single && !in_double { brace = brace - 1 }
                        } else if c == "(" {
                            if !in_single && !in_double { paren = paren + 1 }
                        } else if c == ")" {
                            if !in_single && !in_double { paren = paren - 1 }
                        } else if c == "[" {
                            if !in_single && !in_double { bracket = bracket + 1 }
                        } else if c == "]" {
                            if !in_single && !in_double { bracket = bracket - 1 }
                        }
                        i = i + 1
                    }
                    needs = brace > 0 || paren > 0 || bracket > 0 || in_single || in_double
                }
            }
            .in_continuation = needs
        }

        // Plan 053 M4: Enter 处理 — 续行时放行换行(不执行),否则执行命令。
        // textarea 的 Enter 在 keyup 前已插入 \n,所以 .input 尾部多一个换行:
        // 续行判断照旧对 .input + "\n" 做(trim 后等价);执行前把续行反斜杠
        // 接续(\\\n → 空格)并去掉尾随 \ (repl.rs:907-909 语义)。
        // 注:.Run() 必须放进 if/else 块 —— var 初始化的贪婪解析会把紧随其后的
        // 裸 .Run(t) 吞成方法链(cmd.trim().Run(t))。
        // Plan 053 M4: Enter 处理 — 续行时放行换行(不执行),否则执行命令。
        // cmd 由 onenter 绑定传入(.input 值;textarea 的 Enter 在 keyup 前已
        // 插入 \n,所以 cmd 尾部多一个换行 — trim 后等价)。
        // 续行检测内联在 handler 里(cmd 参数,纯字符串分析):vm 的 handler 内
        // .input 字段读有 GET_FIELD 编码问题,参数传递规避(vue 端等价)。
        // 执行前把续行反斜杠接续(\\\n → 空格)并去掉尾随 \ (repl.rs:907-909)。
        // 注:.Run() 必须放进 if/else 块 —— var 初始化的贪婪解析会把紧随其后的
        // 裸 .Run(t) 吞成方法链(cmd.trim().Run(t))。
        .OnEnter(cmd) -> {
            var trimmed str = cmd.trim()
            var needs bool = false
            if trimmed != "" {
                if trimmed.ends_with("\\") {
                    needs = true
                } else {
                    var brace int = 0
                    var paren int = 0
                    var bracket int = 0
                    var in_single bool = false
                    var in_double bool = false
                    var i int = 0
                    for i < trimmed.len() {
                        var c str = trimmed.substr(i, i + 1)
                        if in_double && c == "\\" && i + 1 < trimmed.len() {
                            i = i + 1
                        } else if c == "'" {
                            if !in_double { in_single = !in_single }
                        } else if c == "\"" {
                            if !in_single { in_double = !in_double }
                        } else if c == "{" {
                            if !in_single && !in_double { brace = brace + 1 }
                        } else if c == "}" {
                            if !in_single && !in_double { brace = brace - 1 }
                        } else if c == "(" {
                            if !in_single && !in_double { paren = paren + 1 }
                        } else if c == ")" {
                            if !in_single && !in_double { paren = paren - 1 }
                        } else if c == "[" {
                            if !in_single && !in_double { bracket = bracket + 1 }
                        } else if c == "]" {
                            if !in_single && !in_double { bracket = bracket - 1 }
                        }
                        i = i + 1
                    }
                    needs = brace > 0 || paren > 0 || bracket > 0 || in_single || in_double
                }
            }
            if !needs && trimmed != "" {
                var cmd2 str = cmd.replace("\\\n", " ")
                var t str = cmd2.trim()
                if t.ends_with("\\") {
                    .Run(t.substr(0, t.len() - 1))
                } else {
                    .Run(t)
                }
            }
        }

        .PickCompletion(item) -> {
            // 替换最后一个 token。VM 规避写法:不用 split/join/列表索引赋值 ——
            // VM 引擎 str.split 返回「字符串表索引的 i32 列表」(非 ListData<String>),
            // SET_ELEM 只支持 ListData<Value> 且按 i32 弹值,三件套在 handler 内
            // 静默中止(Tab 补全失灵的根因)。改用 substr 逐位扫描最后一个空格
            // (substr/len 单位一致性已由 ghost 逻辑在生产验证)。
            var cut int = 0
            var i int = 0
            for i < .input.len() {
                if .input.substr(i, i + 1) == " " {
                    cut = i + 1
                }
                i = i + 1
            }
            .input = .input.substr(0, cut) + item.replacement
            // 补全后输入已变:ghost 按新输入重算(复刻 OnInputComplete 的历史
            // 前缀扫描 —— 不能直接调它,其 tab_active 复位逻辑会终止 Tab 循环),
            // 高亮 spans 同步重算。
            .ghost_text = ""
            var ng str = .input
            if ng != "" {
                var best str = ""
                var gi int = .history.len() - 1
                for gi >= 0 {
                    var gh str = .history[gi]
                    if gh.starts_with(ng) && gh.len() > ng.len() {
                        var gg str = gh.substr(ng.len(), gh.len())
                        if gg.len() > best.len() {
                            best = gg
                        }
                    }
                    gi = gi - 1
                }
                .ghost_text = best
            }
            .DoTokenize()
        }

        .ToggleHistorySearch -> {
            .history_open = !.history_open
        }

        // PB-11:Ctrl+L 清屏。handler body 空 —— renderer emit 模拟转发到
        // store.ClearScreen(vm 剥离 callback prop emit,见 renderer PromptBar.Run 模拟)。
        .OnCtrlL -> { }

        // Ctrl+C:清空当前输入
        .OnCtrlC -> {
            .input = ""
            .history_cursor = -1
            .suggestions = []
            .history_open = false
            .in_continuation = false
            .ghost_text = ""
            .highlighted_spans = []
        }

        // Ctrl+D:空输入时请求退出(像 bash);有输入时不动作
        .OnCtrlD -> {
            if .input.trim() == "" {
                .Exit()
            }
        }

        // Tab:应用第一个补全候选
        .OnTab -> {
            // Tab 只循环**上方候选行**(服务端 /api/complete 候选,如输入 l 时
            // ls/ln),绝不接受 ghost —— 对齐 CLI 版语义:ghost(历史 hint)只由
            // 右箭头(逐字)或 Ctrl+F(整段)激活。注意输入恰好等于候选本身时
            // (如 `ls` 的唯一候选就是 `ls`)Tab 补全无可见变化,属正常。
            // Plan 053 后续:首次 Tab 缓存当前 suggestions 进循环;后续 Tab
            // (用户未再输入)在缓存候选里循环下标。PickCompletion 每次替换最后
            // 一个 token,故循环候选依次替换即可(show Ca → Cargo.lock →
            // Cargo.toml → Cargo.lock …)。用户一旦输入字符,OnInput 会清
            // tab_active 结束循环。
            if .tab_active && .tab_candidates.len() > 0 {
                .tab_index = .tab_index + 1
                if .tab_index >= .tab_candidates.len() {
                    .tab_index = 0
                }
            } else {
                if .suggestions.len() > 0 {
                    .tab_candidates = .suggestions
                    .tab_index = 0
                    .tab_active = true
                } else {
                    .tab_active = false
                }
            }
            if .tab_active {
                .tab_just_completed = true
                .PickCompletion(.tab_candidates[.tab_index])
            }
        }

        // Plan 057 续:右箭头逐字接受 ghost —— 接受一个字符进 input(变实色),
        // ghost 缩短一字。VM 端仅在 ghost 非空时拦截该键(renderer 按 ghost
        // 状态门控 keydown 表);ghost 为空时不拦截,保留默认光标右移。
        .OnRight -> {
            if .ghost_text != "" {
                .input = .input + .ghost_text.substr(0, 1)
                .ghost_text = .ghost_text.substr(1, .ghost_text.len())
                .tab_active = false
                .DoTokenize()
            }
        }

        // ↑ 历史(older):向上翻历史
        .HistoryOlder -> {
            if .history.len() > 0 {
                var cur int = .history_cursor
                if cur < 0 {
                    cur = .history.len()
                }
                if cur > 0 {
                    .history_cursor = cur - 1
                    .input = .history[.history_cursor]
                }
            }
        }

        // ↓ 历史(newer):向下翻历史(到最新则清空)
        .HistoryNewer -> {
            if .history.len() > 0 {
                if .history_cursor >= 0 {
                    var next int = .history_cursor + 1
                    if next >= .history.len() {
                        .history_cursor = -1
                        .input = ""
                    } else {
                        .history_cursor = next
                        .input = .history[next]
                    }
                }
            }
        }

        .Clear -> {
            .input = ""
            .history_cursor = -1
            .suggestions = []
            .history_open = false
            .in_continuation = false
            .ghost_text = ""
            .highlighted_spans = []
        }

        // 退出请求(Ctrl+D 空输入触发 → emit('Exit') → App 处理;浏览器无操作)
        .Exit -> { }

        // Plan 053 M2: Ctrl+F 接受全部 ghost text(对齐 vue acceptGhostFull)。
        .AcceptGhost -> {
            if .ghost_text != "" {
                .input = .input + .ghost_text
                .ghost_text = ""
                .suggestions = []
                .DoTokenize()
            }
        }

        // Plan 053 M2: Ctrl+→ 接受 ghost text 的下一个词(到下一个空白,
        // 对齐 vue acceptGhostWord)。用 substr 逐字符扫描(char_at 在 VM
        // 返回 int codepoint,与 vue 的 string 语义不一致,统一用 substr)。
        .AcceptGhostWord -> {
            if .ghost_text != "" {
                var take str = ""
                var i int = 0
                // 跳过前导空白
                for i < .ghost_text.len() && .ghost_text.substr(i, i + 1) == " " {
                    i = i + 1
                }
                // 取到下一个空白
                for i < .ghost_text.len() && .ghost_text.substr(i, i + 1) != " " {
                    take = take + .ghost_text.substr(i, i + 1)
                    i = i + 1
                }
                if take != "" {
                    .input = .input + take
                    .ghost_text = ""
                    .suggestions = []
                    .DoTokenize()
                }
            }
        }
    }
}
