// front/block_list.at — Block 滚动列表 widget
// Plan 043 M3: 反向生成自 BlockList.vue
//
// 可滚动列表,展示每个命令的 BlockItem 卡片,最新的在底部。
// 自动滚动到最新 block。

use block_item: BlockItem
use types: Block

widget BlockList(blocks: List<Block>, home: str, on_open_path: msg, on_rerun: msg, on_stop: msg, on_delete: msg, on_toggle_collapse: msg, ai_steps_list: []str, ai_steps_styles: []str) {
    msg Msg { OpenPath(str), Rerun(str), Stop, DeleteBlock(int), ToggleCollapse(int) }

    computed {
        // Plan 053 后续:最新 block 的 id(列表非空时取末尾元素),用于给最新块
        // 传 is_latest 以高亮边框。空列表给 -1(此时 for 不渲染,无副作用)。
        latest_id => if .blocks.len() > 0 { .blocks[.blocks.len() - 1].id } else { -1 }
    }

    view {
        scroll {
            // min-h-0:CSS flexbox 惯例(flex-1 子项允许收缩)—— vue 端无副作用;
            // iced 端 flex-1 只设宽 Fill,需 min-h-0 信号才补高 Fill,否则空列表时
            // 滚动区塌缩为 0,把 PromptBar 顶到标题栏下面(输入栏错位根因)。
            style: "flex-1 min-h-0 p-3 gap-2.5"
            // Plan 053 后续:自动滚到底部。auto_scroll 由 vue codegen 识别 → 生成
            // watch(blocks) + 末尾 sentinel div + nextTick(scrollIntoView),新命令
            // 出现/输出流式时都钉在底部。VM 端忽略此属性(无副作用)。
            auto_scroll: "blocks"

            if .blocks.len() == 0 {
                col {
                    style: "h-full items-center justify-center"
                    col {
                        style: "text-center gap-1"
                        text "No commands yet" {
                            style: "text-sm text-muted-foreground"
                        }
                        text "Type a command below, e.g. ls -al" {
                            style: "text-xs text-muted-foreground/60"
                        }
                    }
                }
            }

            for b in .blocks {
                BlockItem(
                    block: .b,
                    home: .home,
                    is_latest: .b.id == .latest_id,
                    on_open_path: .OpenPath,
                    on_rerun: .Rerun,
                    on_stop: .Stop,
                    on_delete: .DeleteBlock,
                    on_toggle_collapse: .ToggleCollapse,
                    // Plan 063 T2: AI 建议分步透传(Prop 链,history 同款)。
                    ai_steps_list: .ai_steps_list,
                    ai_steps_styles: .ai_steps_styles
                )
            }
        }
    }

    on {
        .OpenPath(path) -> { }
        .Rerun(cmd) -> { }
        .Stop -> { }
        // Plan 054 M3: 透传 BlockItem 的删除回调给父级(App → store)。
        .DeleteBlock(id) -> { }
        // Plan 055 D5: 透传折叠回调。
        .ToggleCollapse(id) -> { }
    }
}
