// front/history_search.at — Ctrl+R 历史搜索弹层 widget
// Plan 043 M4: 反向生成自 HistorySearch.vue
//
// fzf 风格的历史搜索面板:输入过滤、↑↓ 导航、Enter 执行、Esc/退格关闭。

widget HistorySearch(history: []str, open: bool, on_run: msg, on_close: msg) {
    msg Msg { Run(str), Close, Move(int) }

    model {
        var query str = ""
        var selected int = 0
        var matches []str = []
        var match_count str = ""
    }

    view {
        if .open {
            col {
                style: "absolute bottom-full left-0 right-0 mb-1 max-h-64 overflow-hidden rounded-md border border-border bg-popover shadow-lg z-50"

                // 搜索框
                row {
                    style: "items-center gap-2 px-3 py-1.5 border-b border-border"
                    text "⌕" {
                        style: "text-xs text-amber-400 font-mono-ash select-none shrink-0"
                    }
                    input {
                        value: .query
                        oninput: .OnQuery
                        onkeyup: .OnQuery
                        onkeydown.esc: .Close
                        onkeydown.enter: .RunSelected
                        onkeydown.up: .Move(-1)
                        onkeydown.down: .Move(1)
                        onkeydown.backspace: .OnBackspace
                        style: "flex-1 bg-transparent outline-none text-sm font-mono-ash"
                        placeholder: "搜索历史…"
                    }
                    text "↑↓ 选择 · ⏎ 执行 · Esc 关闭" {
                        style: "text-[10px] text-muted-foreground/50 select-none shrink-0"
                    }
                }

                // 匹配列表(选中项高亮)。整个 class 用条件表达式(if/else),
                // 不用 + 拼接(避免 codegen 把 Expr::If 渲染成 null)。
                col {
                    style: "overflow-y-auto py-1"
                    for idx, entry in .matches {
                        button .entry {
                            onclick: .Run(.entry)
                            onmousemove: .SelectIdx(idx)
                            style: if idx == .selected {
                                "w-full text-left px-3 py-1 text-sm font-mono-ash bg-accent text-accent-foreground"
                            } else {
                                "w-full text-left px-3 py-1 text-sm font-mono-ash text-muted-foreground hover:bg-white/10"
                            }
                        }
                    }
                    if .matches.len() == 0 {
                        text "无匹配历史" {
                            style: "px-3 py-4 text-center text-xs text-muted-foreground/50"
                        }
                    }
                    // HS-13:匹配计数。用 match_count computed(a2r 解析器对 text
                    // 后的括号表达式支持不稳定,改用 computed 字段)。
                    if .matches.len() > 0 {
                        text .match_count {
                            style: "px-3 py-1 text-center text-[10px] text-muted-foreground/50"
                        }
                    }
                }
            }
        }
    }

    on {
        .Run(cmd) -> { }
        .Close -> { }

        // ↑↓ 移动选中(循环)
        .Move(delta) -> {
            if .matches.len() > 0 {
                .selected = (.selected + delta + .matches.len()) % .matches.len()
            }
        }

        .SelectIdx(idx) -> {
            .selected = idx
        }

        // 退格在空 query 时关闭(像 fzf-history)
        .OnBackspace -> {
            if .query == "" {
                .Close()
            }
        }

        // Enter:执行选中项
        .RunSelected -> {
            if .selected < .matches.len() {
                .Run(.matches[.selected])
            }
        }

        // 输入变化 → 过滤历史。HS-04 三要素(对齐 Vue HistorySearch.vue:30-37):
        // 大小写不敏感(to_lower)、倒序(newest first,从尾部遍历)、cap 50。
        .OnQuery -> {
            var q str = .query.trim().to_lower()
            var out []str = []
            // 倒序:newest first。.history 是 chronological(last = newest),
            // 从尾部向前遍历,push 到 out 即得倒序。
            var i int = .history.len() - 1
            for i >= 0 {
                if q != "" {
                    if .history[i].to_lower().contains(q) {
                        out.push(.history[i])
                    }
                } else {
                    out.push(.history[i])
                }
                // cap 50(对齐 Vue slice(0,50))。
                if out.len() >= 50 {
                    i = 0
                }
                i = i - 1
            }
            .matches = out
            .selected = 0
            .match_count = out.len().str() + " matches"
        }
    }
}
