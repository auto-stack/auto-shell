// front/app.at — App 根布局 widget
// Plan 043 M3: 反向生成自 App.vue
//
// 根布局:侧栏 + 标题栏(cwd + git) + Block 列表 + PromptBar

use shell_store: ShellStore
use block_list: BlockList
use prompt_bar: PromptBar
use tool_sidebar: ToolSidebar

widget App {
    msg Msg { Init, Pick(str), RunSmart(str), Rerun(str), Stop, Clear, Exit,
              ToggleSidebar }

    model {
        var sidebar_open bool = true
        var injected_command str = ""
    }

    view {
        row {
            style: "h-full bg-background"

            // 侧栏(可选)
            if .sidebar_open {
                ToolSidebar(
                    commands: .store.commands,
                    smart_commands: .store.smart_commands,
                    on_pick: .Pick,
                    on_run_smart: .RunSmart
                )
            }

            // 主列
            col {
                style: "flex-1 flex-col min-w-0"

                // 标题栏:侧栏开关 + cwd + git
                row {
                    style: "items-center gap-2 px-3 h-9 border-b border-border bg-card/40 shrink-0"
                    button "🛠" {
                        onclick: .ToggleSidebar
                        style: "text-xs px-1.5 py-0.5 rounded text-muted-foreground hover:text-foreground hover:bg-muted/60"
                    }
                    text "ash" {
                        style: "text-sm font-semibold text-foreground/90"
                    }
                    text "·" {
                        style: "text-muted-foreground/40"
                    }
                    text .store.cwd {
                        style: "text-xs font-mono-ash text-sky-300/80 truncate"
                    }
                    if .store.git_label != "" {
                        text .store.git_label {
                            style: "text-xs font-mono-ash text-amber-400/80 shrink-0"
                        }
                    }
                }

                // Block 列表(可滚动)
                BlockList(
                    blocks: .store.blocks,
                    home: .store.home,
                    on_open_path: .Pick,
                    on_rerun: .Rerun,
                    on_stop: .Stop
                )

                // 命令输入
                PromptBar(
                    cwd: .store.cwd,
                    home: .store.home,
                    command_names: .store.command_names,
                    history: .store.history,
                    injected_command: .injected_command,
                    on_run: .RunCommand,
                    on_injected: .Clear,
                    on_clear: .Clear,
                    on_exit: .Exit
                )
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .Pick(name) -> {
            .injected_command = name
        }

        .RunSmart(name) -> {
            store.RunSmart(.store.next_id, name, [])
            .store.next_id = .store.next_id + 1
        }

        .Rerun(cmd) -> {
            store.RunCommand(cmd)
        }

        .Stop -> {
            store.Cancel()
        }

        .Clear -> {
            .injected_command = ""
        }

        .Exit -> {
            // 在 Tauri 版调用 window.close();在浏览器版无操作
        }

        .ToggleSidebar -> {
            .sidebar_open = !.sidebar_open
        }
    }
}
