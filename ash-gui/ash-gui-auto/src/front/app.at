// front/app.at — App 根布局 widget
// Plan 043 M3: 反向生成自 App.vue
//
// 根布局:侧栏 + 标题栏(cwd + git) + Block 列表 + PromptBar

use shell_store: ShellStore
use block_list: BlockList
use prompt_bar: PromptBar
use tool_sidebar: ToolSidebar
// BUG-A workaround (VM merged 模式):store handler body 链接到 App 作用域时,
// store 的 `use back.api` 导入不透传。App 必须自己也 import 这些 fn
// (015-notes 的 app.at 第 7 行同理)。列 app 经 store 间接用到的全部 back.api fn。
use back.api: command_list, history, complete, run_command, prompt_context, open_path, ai_pending, boot_script

widget App {
    msg Msg { Init, Pick(str), RunCommand(str), Rerun(str), Stop, Clear, Exit,
              ToggleSidebar, ToggleTheme, OpenPath(str), ClearScreen, DeleteBlock(int), ToggleCollapse(int), RefreshJobs,
              ToggleJobs, KillJob(int), PickNext(int), ToggleChat }

    model {
        var sidebar_open bool = true
        var injected_command str = ""
        // Plan 062 T2: 后台作业面板开合(标题栏 ⚙ 切换)。
        var jobs_open bool = false
        // Plan 054 M5: 主题(dark/light)。index.css 已定义 .dark 下的 CSS 变量
        // 覆盖,toggle 切 <html> 的 .dark class 即可生效。
        // 默认 true:浏览器脚手架 index.html 硬编码 <html class="dark">(深色),
        // VM/iced 由本字段驱动调色板 —— 两端默认一致为深色。
        var dark_mode bool = true
    }

    computed {
        // Plan 053 M6-B2: 标题栏 cwd 缩写(home 前缀 → ~),内联实现。
        cwd_display => if .store.home != "" && .store.cwd.starts_with(.store.home) { "~" + .store.cwd.substr(.store.home.len(), .store.cwd.len()) } else { .store.cwd }
        // Plan 054 M5: 主题切换图标(dark=☀ / light=🌙)。
        theme_glyph => if .dark_mode { "☀" } else { "☾" }
        // Plan 055 Phase A: 后台作业计数(标题栏,点击刷新)。
        // 注:不去 .str()——JS '+' 自动 coerce number 成字符串;加 .str()
        // 产物是 length.str()(JS number 无 .str() 方法,jobs 非空时会 throw)。
        jobs_label => "⚙ " + .store.job_list.len()
    }

    view {
        row {
            style: "w-full h-full bg-background"

            // 侧栏(可选)
            if .sidebar_open {
                ToolSidebar(
                    commands: .store.commands,
                    on_pick: .Pick
                )
            }

            // 主列
            col {
                style: "flex-1 flex-col min-w-0"

                // 标题栏:侧栏开关 + cwd + git
                row {
                    style: "items-center gap-2 px-3 h-9 border-b border-border bg-card/40 shrink-0"
                    button "☰" {
                        onclick: .ToggleSidebar
                        style: "text-xs px-1.5 py-0.5 rounded text-muted-foreground hover:text-foreground hover:bg-white/10"
                    }
                    text "ash" {
                        style: "text-sm font-semibold text-foreground/90"
                    }
                    text "·" {
                        style: "text-muted-foreground/40"
                    }
                    text .cwd_display {
                        style: "text-xs font-mono-ash text-sky-300/80 truncate"
                    }
                    if .store.git_label != "" {
                        text .store.git_label {
                            style: "text-xs font-mono-ash text-amber-400/80 shrink-0"
                        }
                    }
                    // Plan 055 Phase A + 062 T2: 后台作业计数(点击开合作业
                    // 面板;ml-auto 推右)。button 而非 text:VM 端 text onclick
                    // 无点击先例,button 是已验证路径(☰ 同款)。
                    if .store.job_list.len() > 0 {
                        button .jobs_label {
                            onclick: .ToggleJobs
                            style: "text-xs px-1.5 py-0.5 rounded text-amber-400/80 hover:text-amber-300 hover:bg-amber-500/10 cursor-pointer select-none shrink-0"
                        }
                    }
                    // Plan 063 T4: chat 抽屉开关(?? 提交时自动开,手动可关)。
                    button "💬" {
                        onclick: .ToggleChat
                        style: "text-xs px-1.5 py-0.5 rounded text-sky-400/80 hover:text-sky-300 hover:bg-sky-500/10 cursor-pointer select-none shrink-0"
                    }
                    // Plan 054 M5: 主题切换。
                    text .theme_glyph {
                        onclick: .ToggleTheme
                        style: if .store.job_list.len() > 0 { "text-sm px-1.5 py-0.5 rounded text-muted-foreground hover:text-foreground hover:bg-white/10 cursor-pointer select-none" } else { "ml-auto text-sm px-1.5 py-0.5 rounded text-muted-foreground hover:text-foreground hover:bg-white/10 cursor-pointer select-none" }
                    }
                }

                // Plan 062 T2: 后台作业面板(⚙ 切换;列表由 SSE
                // JobStarted/JobDone 实时维护,开面板时再拉一次兜底)。
                if .jobs_open {
                    if .store.job_list.len() > 0 {
                        col {
                            style: "border-b border-border bg-card/30 px-3 py-2 gap-1 shrink-0"
                            for j in .store.job_list {
                                row {
                                    style: "items-center gap-2 text-xs font-mono-ash"
                                    text "#" + j.id {
                                        style: "text-muted-foreground w-8 shrink-0"
                                    }
                                    text j.command {
                                        style: "text-foreground/80 truncate flex-1 min-w-0"
                                    }
                                    if j.state == "Running" {
                                        text "running" {
                                            style: "text-amber-400/80 shrink-0"
                                        }
                                    } else {
                                        text "exit " + j.exit_code {
                                            style: "text-muted-foreground shrink-0"
                                        }
                                    }
                                    button "✕" {
                                        onclick: .KillJob(j.id)
                                        style: "px-1.5 py-0.5 rounded text-muted-foreground hover:text-red-400 hover:bg-red-500/10 cursor-pointer shrink-0"
                                    }
                                }
                            }
                        }
                    }
                }

                // Block 列表(可滚动)
                BlockList(
                    blocks: .store.blocks,
                    home: .store.home,
                    on_open_path: .OpenPath,
                    on_rerun: .Rerun,
                    on_stop: .Stop,
                    on_delete: .DeleteBlock,
                    on_toggle_collapse: .ToggleCollapse,
                    // Plan 063 T2: AI 建议分步(store 级数据,merged 模式
                    // renderer 构造的块不含新契约字段 —— 引擎边界,经 prop
                    // 链传给 BlockItem 渲染)。
                    ai_steps_list: .store.ai_steps_list,
                    ai_steps_styles: .store.ai_steps_styles
                )

                // Plan 063 T1: suggest-next chips(命令完成后出现,下个
                // command_result 的 RefreshContext 拉新/清空 —— CLI「下个提
                // 示符前展示」的 GUI 等价)。渲染读 store 字段(job_list 的
                // for j 同款先例 —— []str 走 widget prop 在 VM 视图侧读不
                // 到);点击 .PickNext → injected_command 注入(Pick 同语义,
                // store 注入 + App 级 handler,计划 T1 原口径)。
                if .store.ai_next_cmds.len() > 0 {
                    row {
                        style: "items-center gap-2 rounded-md border border-emerald-500/20 bg-emerald-500/5 px-2 py-1 mx-3 mb-1"
                        text "💡 接下来:" {
                            style: "text-[10px] text-emerald-400/80 font-semibold shrink-0 select-none"
                        }
                        for i, c in .store.ai_next_cmds {
                            button c {
                                onclick: .PickNext(i)
                                style: "text-xs font-mono-ash px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300/90 hover:bg-emerald-500/20 cursor-pointer select-none"
                            }
                        }
                    }
                }

                // 命令输入
                PromptBar(
                    cwd: .store.cwd,
                    home: .store.home,
                    command_names: .store.command_names,
                    // Plan 057 (Bug 2):传原始字段而非 store computed(history =>
                    // persisted_history)—— VM 的 .store.X 展平只读裸字段,computed
                    // 名解析 FieldNotFound → history prop 恒 unresolved → 动态字段
                    // 缺失 → handler 读 .history 报 not-found 静默中止(ghost 死因)。
                    // vue 端两值等价(computed 即其别名)。
                    history: .store.persisted_history,
                    injected_command: .injected_command,
                    // Plan 062 T11:AI 建议命令(`?` 翻译完成时 RefreshContext
                    // 写入;PromptBar 建议条渲染 + 编辑/执行/关闭)。
                    ai_suggestion: .store.ai_pending_cmd,
                    on_run: .RunCommand,
                    on_injected: .Clear,
                    on_clear: .ClearScreen,
                    on_exit: .Exit
                )
            }

            // Plan 063 T4: AI chat 抽屉(右侧面板;?? 提交自动开,💬 手动
            // 开合)。chat_events 由 SSE ai_* 事件族维护(VM 轨 renderer 直写
            // / vue 轨无参 handler,job_list 同款双轨);块内 ?? 形态保留为
            // fallback,抽屉是结构化渲染(回合分隔线/提问/回答/工具行)。
            if .store.chat_drawer_open {
                col {
                    style: "w-80 shrink-0 border-l border-border bg-card/30 flex-col min-h-0"

                    row {
                        style: "items-center gap-2 px-3 h-9 border-b border-border shrink-0"
                        text "💬 AI 对话" {
                            style: "text-xs font-semibold text-sky-300/90 select-none"
                        }
                        button "✕" {
                            onclick: .ToggleChat
                            style: "ml-auto text-xs px-1.5 py-0.5 rounded text-muted-foreground hover:text-red-400 hover:bg-red-500/10 cursor-pointer select-none"
                        }
                    }

                    // 会话流(可滚动)。kind 决定样式:turn=分隔线,user=提问
                    // (sky),text=回答正文,tool/result=⚙/← 等宽暗色行。
                    col {
                        style: "flex-1 overflow-y-auto px-3 py-2 gap-1 min-h-0"
                        for ev in .store.chat_events {
                            if ev.kind == "turn" {
                                text ev.text {
                                    style: "text-[10px] text-muted-foreground/70 font-mono-ash select-none pt-1"
                                }
                            }
                            if ev.kind == "user" {
                                text ev.text {
                                    style: "text-xs text-sky-200/90 whitespace-pre-wrap break-words"
                                }
                            }
                            if ev.kind == "text" {
                                text ev.text {
                                    style: "text-xs text-foreground/85 whitespace-pre-wrap break-words"
                                }
                            }
                            if ev.kind == "tool" {
                                text ev.text {
                                    style: "text-[11px] font-mono-ash text-amber-400/80 whitespace-pre-wrap break-words"
                                }
                            }
                            if ev.kind == "result" {
                                text ev.text {
                                    style: "text-[11px] font-mono-ash text-muted-foreground/80 whitespace-pre-wrap break-words"
                                }
                            }
                        }
                        if .store.chat_events.len() == 0 {
                            text "暂无对话 —— 输入 ?? <消息> 开始" {
                                style: "text-[11px] text-muted-foreground/60"
                            }
                        }
                    }

                    row {
                        style: "px-3 py-1.5 border-t border-border shrink-0"
                        text "?? 提问 · ?? /clear 清空 · 块内形态保留" {
                            style: "text-[10px] text-muted-foreground/50 select-none"
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .Pick(name) -> {
            .injected_command = name
        }

        // Plan 063 T1: suggest-next chip 点击(handler 侧读 store 数组 ✓,
        // .ai_next_cmds[i] 两层索引读;注入 injected_command 走 Pick 桥)。
        .PickNext(i) -> {
            if i >= 0 && i < .store.ai_next_cmds.len() {
                var ncmd str = .store.ai_next_cmds[i]
                if ncmd != "" {
                    .injected_command = ncmd
                }
            }
        }

        // Plan 063 T4: chat 抽屉开合(store 级字段,?? 提交时 RunCommand
        // 自动置开)。
        .ToggleChat -> {
            store.ToggleChatDrawer()
        }

        .Rerun(cmd) -> {
            store.RunCommand(cmd)
        }

        // PromptBar 的 on_run 回调:输入框执行命令(空命令忽略)
        .RunCommand(cmd) -> {
            if cmd.trim() != "" {
                store.RunCommand(cmd)
            }
        }

        .Stop -> {
            store.Cancel()
        }

        // 点击表格单元格中的文件/目录:用 OS 默认程序打开
        .OpenPath(path) -> {
            store.OpenPath(path)
        }

        .Clear -> {
            .injected_command = ""
        }

        // Ctrl+L 清屏:归档所有 blocks(PromptBar on_clear 回调)
        .ClearScreen -> {
            store.ClearScreen()
        }

        // Plan 054 M3: 删除指定 block(BlockItem ✕ 按钮 → BlockList → 此处)。
        .DeleteBlock(id) -> {
            store.DeleteBlock(id)
        }

        // Plan 055 D5: 切换 block 折叠(BlockItem ▸/▾ → BlockList → 此处)。
        .ToggleCollapse(id) -> {
            store.ToggleCollapse(id)
        }

        .Exit -> {
            // 在 Tauri 版调用 window.close();在浏览器版无操作
        }

        .ToggleSidebar -> {
            .sidebar_open = !.sidebar_open
        }

        // Plan 062 T2: 开合后台作业面板。列表由 SSE JobStarted/JobDone 实时
        // 维护(renderer-owned Array)—— 不再调 store.RefreshJobs():其
        // `.job_list = jobs()` 是 VM 原生赋值,会把 renderer-owned Array 换回
        // VmRef 列表,视图随即丢失 ⚙/面板(实测点击 ⚙ 后列表被清空)。
        .ToggleJobs -> {
            .jobs_open = !.jobs_open
        }

        // Plan 062 T2: 作业面板 kill 按钮 → store(其内部 kill_job + 刷新)。
        .KillJob(job_id) -> {
            store.KillJob(job_id)
        }

        // Plan 054 M5: 切主题。document.documentElement.classList.toggle("dark")
        // 由 ts_adapter 透传(navigator API 同模式,M6-B3 已验证)。切换后同步
        // .dark_mode 驱动图标(☀/🌙)。
        .ToggleTheme -> {
            document.documentElement.classList.toggle("dark")
            .dark_mode = !.dark_mode
        }
    }
}
