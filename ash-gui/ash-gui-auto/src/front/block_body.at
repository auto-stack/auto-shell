// front/block_body.at — 输出渲染器分发 widget
// Plan 043 M4: 反向生成自 BlockBody.vue
//
// 根据 RenderedOutput 的 kind 分发到对应渲染器(Table/Record/Code/Text/Error)。
// 在 Vue 里用 discriminated union;在 Auto 里用 if/else if 链。
//
// 渲染器(view fn)与 widget 同文件定义——与 015-notes 的 NoteItem 模式一致。
// view fn 必须用 **PascalCase** 命名(codegen 只对内联 PascalCase 标签,见
// extract.rs is_pascal 检查),参数引用用裸标识符(output.columns 而非
// .output.columns,substitute_expr 只替换裸 Ident 和单层 self-dot)。
// 详见 DEBTS。

use types: RenderedOutput, CodeSpan

/// 表格渲染器(ls/ps 等结构化命令的输出)
// 参数引用用裸标识符(output.columns / col / row / cell)而非 .output.columns——
// 与 015-notes NoteItem 的 note.title 模式一致:substitute_expr 只替换裸 Ident
// 和单层 self-dot(.field),嵌套 self-dot(.output.text)无法替换,会导致 view fn
// 调用落回普通组件(生成 <div :output>)。见 DEBTS 第 5 项限制。
view fn RenderTable(output RenderedOutput) {
    col {
        style: "text-sm font-mono-ash"
        // 表头
        row {
            style: "gap-4 px-2 py-1 border-b border-border text-muted-foreground text-xs"
            for col in output.columns {
                text col { }
            }
        }
        // 表行
        for row in output.rows {
            row {
                style: "gap-4 px-2 py-1 border-b border-border/50"
                for cell in row {
                    text cell.text { }
                }
            }
        }
    }
}

/// 代码渲染器(show 命令的语法高亮输出)
/// CodeSpan 携带 RGB + bold/italic,前端直接渲染为着色文本。
view fn RenderCode(output RenderedOutput) {
    col {
        style: "text-sm font-mono-ash overflow-x-auto"
        for line in output.code_lines {
            row {
                for span in line {
                    text span.text {
                        style: "color: rgb(" + span.r + "," + span.g + "," + span.b + ")"
                    }
                }
            }
        }
    }
}

/// 纯文本渲染器(echo/cat 等命令的输出)
view fn RenderText(output RenderedOutput) {
    text output.text {
        style: "text-sm font-mono-ash text-foreground/90 whitespace-pre-wrap break-words"
    }
}

/// 错误渲染器
view fn RenderError(output RenderedOutput) {
    col {
        style: "px-3 py-2 rounded bg-red-500/10 border border-red-500/20"
        text output.error_message {
            style: "text-sm font-mono-ash text-red-400"
        }
    }
}

widget BlockBody(output: RenderedOutput, on_open_path: msg) {
    msg Msg { OpenPath(str) }

    view {
        col {
            if .output.kind == "Table" {
                RenderTable(output: .output)
            } else if .output.kind == "Record" {
                // Record 渲染(简化:用文本形式)
                text "Record" { }
            } else if .output.kind == "Code" {
                RenderCode(output: .output)
            } else if .output.kind == "Text" {
                RenderText(output: .output)
            } else if .output.kind == "Error" {
                RenderError(output: .output)
            } else {
                text "(no output)" {
                    style: "text-xs text-muted-foreground italic"
                }
            }
        }
    }

    on {
        .OpenPath(path) -> { }
    }
}
