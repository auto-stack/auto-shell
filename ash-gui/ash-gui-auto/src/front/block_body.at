// front/block_body.at — 输出渲染器分发 widget
// Plan 043 M4: 反向生成自 BlockBody.vue
//
// 根据 RenderedOutput 的 serde tagged-union 变体(Table/Record/Code/Text/Error)
// 分发到对应渲染器。服务端序列化为 {"Table":{...}} | {"Text":"..."} 等,字段
// 是可选变体 key(RenderedOutput.Table: ?TableOutput),前端用 `!= None` 判断
// 并窄化类型(等价于 Vue 里 discriminated union 的 'Table' in o 检查)。
//
// 渲染器(view fn)与 widget 同文件定义——与 015-notes 的 NoteItem 模式一致。
// view fn 必须用 **PascalCase** 命名(codegen 只对内联 PascalCase 标签,见
// extract.rs is_pascal 检查),参数引用用裸标识符(output.columns 而非
// .output.columns,substitute_expr 只替换裸 Ident 和单层 self-dot)。
// 详见 DEBTS。

use types: RenderedOutput, TableOutput, CodeOutput, ErrorOutput, AiSuggestionOutput

/// 表格渲染器(ls/ps 等结构化命令的输出)
// 参数是窄化后的 TableOutput(view fn 只替换裸 Ident 参数,把 .output.Table
// 传进来即可在 body 里用 output.columns)。
//
// Plan 046:用 col/row 替代 HTML table 标签(table/thead/tbody/tr/th/td)。
// VM 的 aura_view_builder 不支持 HTML table 标签(fallback 成 Column 会丢数据行)。
// col/row 是 VM 原生支持的对齐 iced 的 Table 渲染方式(renderer.rs:1289 column of rows)。
//
// 列对齐用 CSS grid:`display:grid; grid-template-columns: repeat(N, minmax(60px,1fr))`,
// N = output.columns.len()。这要把 N 写进「动态 style 表达式」;codegen 的
// substitute_expr 之前不对方法调用链(output.columns.len())做 view-fn 参数替换
// (Call 分支只替换 args 不替换 callee)→ 产物留下 output.columns.length(应为
// output.Table.columns.length)→ undefined → 整个 Table 渲染失败(空块)。
// 已在 extract.rs substitute_expr 的 Call 分支补上 callee 替换,故此 grid 方案
// 现在 vue/VM 都正确生成,无需手改 gen。
//
// Plan 052: 处理两种 RenderedCell 变体 + zebra/header/padding 样式。
view fn RenderTable(output TableOutput) {
    col {
        style: "w-full text-sm font-mono-ash border border-border rounded-md overflow-hidden bg-card/50"
        // 表头行
        // 表头行(grid 列对齐:vue 端 :style 生效;iced 忽略 CSS 声明,flex 兜底)
        row {
            style: "display:grid; grid-template-columns: repeat(" + output.columns.len().str() + ", minmax(60px, 1fr)); border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04)"
            for cname in output.columns {
                text cname {
                    style: "px-3 py-2 text-left font-semibold whitespace-nowrap overflow-hidden text-ellipsis"
                }
            }
        }
        // 数据行 — 二维数组 for cell in row(Plan 046 已修 VM 嵌套 for bug)
        for row in output.rows {
            row {
                style: "display:grid; grid-template-columns: repeat(" + output.columns.len().str() + ", minmax(60px, 1fr)); border-bottom: 1px solid rgba(255,255,255,0.06)"
                for cell in row {
                    // Plan 052: 处理两种 RenderedCell 变体。
                    // Text: 纯文本(echo 等);Tagged: 带语义标签的文本(ls 的文件名/权限等)。
                    if cell.Text != None {
                        text cell.Text {
                            style: "px-3 py-1.5 text-muted-foreground text-left overflow-hidden text-ellipsis whitespace-nowrap"
                        }
                    }
                    if cell.Tagged != None {
                        // Plan 053 后续:按 kind 着色(对齐 ash-gui-vue cellStyle.ts /
                        // iced tag_color):Dir→sky, CodeAtRs→emerald, Executable→cyan,
                        // Config→amber, Permission→muted, Plain→foreground。
                        // 颜色三元走 style(→ Vue :class / iced 动态求值)—— 这是
                        // 唯一的跨 target 通道:class: 三元 Vue 容器支持、但 iced 的
                        // extract_style 只读静态字符串会整体丢弃(高亮反复丢失的根因)。
                        text cell.Tagged.text {
                            style: if cell.Tagged.kind == "Dir" { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-sky-400" } else if cell.Tagged.kind == "CodeAtRs" { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-emerald-400" } else if cell.Tagged.kind == "Executable" { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-cyan-300" } else if cell.Tagged.kind == "Config" { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-amber-300" } else if cell.Tagged.kind == "Permission" { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-muted-foreground" } else { "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-foreground" }
                        }
                    }
                }
            }
        }
    }
}

/// 代码渲染器(show 命令的语法高亮输出)
/// CodeSpan 携带 RGB + bold/italic,前端渲染为着色 + 粗/斜体文本(BB-12)。
view fn RenderCode(output CodeOutput) {
    col {
        style: "text-sm font-mono-ash overflow-x-auto"
        for line in output.lines {
            row {
                for span in line {
                    text span.text {
                        // BB-12:bold/italic 对齐 Vue CodeView.vue:16-24。
                        // 颜色 + font-weight + font-style 拼成内联 style。
                        style: "color: rgb(" + span.r + "," + span.g + "," + span.b + ");font-weight:" + (if span.bold { "bold" } else { "normal" }) + ";font-style:" + (if span.italic { "italic" } else { "normal" })
                    }
                }
            }
        }
    }
}

/// 错误渲染器
view fn RenderError(output ErrorOutput) {
    col {
        style: "px-3 py-2 rounded bg-red-500/10 border border-red-500/20"
        text output.message {
            style: "text-sm font-mono-ash text-red-400"
        }
    }
}

/// Plan 062 T11:AI NL→命令建议(纯展示版)。实际渲染走 block_item.at 的
/// 内联卡片(VM 子 widget prop 字段读取 bug,Text/Code 同因内联),带
/// [▶ 执行]/[✕ 取消] 按钮;本渲染器仅覆盖契约完整性(无事件上下文)。
view fn RenderAiSuggestion(output AiSuggestionOutput) {
    col {
        style: "gap-1"
        text output.question {
            style: "text-xs text-muted-foreground"
        }
        text output.cmd {
            style: "text-sm font-mono-ash text-foreground whitespace-pre-wrap break-words"
        }
        if output.notice != "" {
            text output.notice {
                style: "text-xs text-red-400"
            }
        }
    }
}

/// Record 渲染器:key/value 字段列表(镜像手写 RecordView.vue)。
/// MemoryInfo 额外显示 usage 进度条:遍历 fields 找 usage_percent/usage 字段,
/// 取其数值渲染 Progress。fields 是 (key, cell) 元组数组,用 idx 下标遍历
/// (field.0 = key, field.1 = cell)。
view fn RenderRecord(output RecordOutput) {
    col {
        style: "space-y-3 px-1 py-1"
        // MemoryInfo 进度条:优先 usage_percent,回退 usage(Vue RecordView.vue:17-26)。
        // Plan 053 B4: value 用 to_float() 兜底 —— 服务端字段可能是 "75%" 带尾
        // 百分号字符串,直接 Number("75%")→NaN。to_float 经 P5-3 在 view 表达式
        // 映射为 parseFloat,自动在 % 处停读(parseFloat("75%")→75)。
        if output.atom_type == "MemoryInfo" {
            for idx, field in output.fields {
                if field.0 == "usage_percent" {
                    if field.1.Text != None {
                        progress {
                            value: field.1.Text.to_float()
                            max: 100
                        }
                    }
                    if field.1.Tagged != None {
                        progress {
                            value: field.1.Tagged.text.to_float()
                            max: 100
                        }
                    }
                }
            }
            // BB-11 回退:无 usage_percent 时用 usage 字段。
            for idx, field in output.fields {
                if field.0 == "usage" {
                    if field.1.Text != None {
                        progress {
                            value: field.1.Text.to_float()
                            max: 100
                        }
                    }
                    if field.1.Tagged != None {
                        progress {
                            value: field.1.Tagged.text.to_float()
                            max: 100
                        }
                    }
                }
            }
        }
        // key/value 列表(grid 两列)。value 是 RenderedCell({Text, Tagged}),
        // 按存在的变体取纯文本(与 RenderTable 同模式,先 nil 守卫避免 TS 窄化问题)。
        for idx, field in output.fields {
            row {
                style: "grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm font-mono-ash"
                text field.0 {
                    style: "text-muted-foreground"
                }
                if field.1.Text != None {
                    text field.1.Text {
                        style: "text-foreground/90"
                    }
                }
                if field.1.Tagged != None {
                    text field.1.Tagged.text {
                        style: "text-foreground/90"
                    }
                }
            }
        }
    }
}

widget BlockBody(output: RenderedOutput, on_open_path: msg) {
    msg Msg { OpenPath(str) }

    view {
        col {
            if .output.Table != None {
                RenderTable(output: .output.Table)
            } else if .output.Record != None {
                RenderRecord(output: .output.Record)
            } else if .output.Code != None {
                RenderCode(output: .output.Code)
            } else if .output.Text != None {
                text .output.Text {
                    style: "text-sm font-mono-ash text-foreground/90 whitespace-pre-wrap break-words"
                }
            } else if .output.Error != None {
                RenderError(output: .output.Error)
            } else if .output.AiSuggestion != None {
                RenderAiSuggestion(output: .output.AiSuggestion)
            } else {
                text "(no output)" {
                    style: "text-xs text-muted-foreground italic"
                }
            }
        }
    }

    on {
        .OpenPath(path) -> { }
    }
}
