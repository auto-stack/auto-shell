// front/shell_store.at — Shell 状态管理 store
// Plan 043 M2: 反向生成自 useShellTauri.ts + useShellHttp.ts
//
// 这个 store 封装了 Shell 后端的所有交互:命令执行、补全、历史、流式输出。
// transport 选择(HTTP vs Tauri)不在 .at 里——由 codegen target 决定
// (axum → HTTP fetch,tauri → invoke/listen)。这与 015-notes 的模式一致:
// 同一份 api.at,生成不同 transport 的代码。

use back.api: command_list, complete, run_smart, prompt_context, history, open_path, stream, run_command, cancel, jobs, kill_job
use types: Block, BlockStatus, BootSnapshot, CompletionItem, PromptContext, ToolEntry, SmartCommandEntry, ShellEvent, RenderedOutput, JobInfo

// format_git_label — APP-05/06:格式化 git 分支+状态标签。
// 对齐 Vue App.vue:75-92:"⎇ main +2 !1 ?3 ✗0 ⇡1 ⇣0"。
// 抽成 module fn 供 Init/RefreshGit/RunResult 调用(computed 多行 body 在 vm 风险)。
fn format_git_label(branch str, staged int, unstaged int, untracked int, conflicted int, ahead int, behind int) str {
    if branch == "" {
        return ""
    }
    var label str = "⎇ " + branch
    if staged > 0 {
        label = label + " +" + staged.str()
    }
    if unstaged > 0 {
        label = label + " !" + unstaged.str()
    }
    if untracked > 0 {
        label = label + " ?" + untracked.str()
    }
    if conflicted > 0 {
        label = label + " ✗" + conflicted.str()
    }
    if ahead > 0 {
        label = label + " ⇡" + ahead.str()
    }
    if behind > 0 {
        label = label + " ⇣" + behind.str()
    }
    return label
}

// compute_git_label — Plan 051 M3 (GAP-A): 安全地从 PromptContext 构造 git_label。
// 服务端 PromptContext.git_status 是 Option<GitStatusInfo> —— 非 git 目录时为 null,
// 直接访问 .git_status.staged 会 null 解引用崩溃。此 wrapper 先判空。
// api.at 把 git_status 擦成非可选 struct(type 层),但 codegen 生成 any,运行时
// 形状由服务端决定,故这里用 != None 运行时判断。
fn compute_git_label(pc PromptContext) str {
    if pc.git_status != None {
        return format_git_label(pc.git_branch, pc.git_status.staged, pc.git_status.unstaged, pc.git_status.untracked, pc.git_status.conflicted, pc.git_status.ahead, pc.git_status.behind)
    }
    // git_status 为 null(非 git 目录):只显示分支名,或空
    if pc.git_branch != "" {
        return "⎇ " + pc.git_branch
    }
    return ""
}

store ShellStore {
    model {
        // ── 核心状态 ──
        var blocks List<Block> = List<Block>.new([])
        var cwd str = ""
        var home str = ""
        var next_id int = 0

        // ── Boot 数据 ──
        var commands List<ToolEntry> = List<ToolEntry>.new([])
        var smart_commands List<SmartCommandEntry> = List<SmartCommandEntry>.new([])
        var command_names []str = []

        // ── 历史持久化 (Plan 040 M6) ──
        var persisted_history []str = []

        // ── Prompt 上下文 (Plan 041 M5: git 分支/状态) ──
        // Note: PromptContext.git_status 类型是 GitStatusInfo(非可选 struct),
        // 不能用 None 默认(parse FieldMismatch)。用一个全零 GitStatusInfo 占位
        // (inline,不在 model{} 里声明临时变量——model{} 只接受字段默认值)。
        var git_info PromptContext = PromptContext{ git_branch: "", git_status: GitStatusInfo{ staged: 0, unstaged: 0, untracked: 0, conflicted: 0, ahead: 0, behind: 0 } }

        // ── 侧栏开关 ──
        var sidebar_open bool = true

        // Plan 055 Phase A: 后台作业列表(`cmd &`)。
        var job_list List<JobInfo> = List<JobInfo>.new([])

        // ── git_label(APP-05/06):格式化的 git 分支+状态标签 ──
        // computed 多行 body 在 vm 风险,改用 handler 调 module fn 写此字段。
        // 格式对齐 Vue App.vue:75-92:"⎇ main +2 !1 ?3 ✗0 ⇡1 ⇣0"。
        var git_label str = ""

        // ── SSE 桥预置字段(M1)──
        // VM 无法把 struct 作为 handler 参数(renderer push_value 对 Obj 推占位 0)。
        // renderer 在触发 RunOutput/RunResult 前,把事件数据写入这些字段;
        // handler body 读它们(无参 handler)。RunCommand 后写 __pending_command_*,
        // renderer 读出后提交执行器线程(merged 模式 std::process / HTTP 模式 POST)。
        var __sse_block_id int = 0
        var __sse_chunk str = ""
        var __sse_cwd str = ""
        var __sse_status str = ""
        var __sse_output_text str = ""
        // Plan 052: 完整结构化 output(vue 模式 SSE 透传 r.output 整个对象)。
        // 承载 Table/Record/Code/Error/Text 等所有变体(__sse_output_text 只能承载文本)。
        // VM merged 模式不填此字段(renderer 走 update_block_in_state 直写 block),
        // RunResult handler 判断它为空时回退到 streamed_text。
        var __sse_output RenderedOutput = RenderedOutput{}
        var __sse_duration_ms int = 0
        // Plan 054 M2: SSE 透传的退出码(对齐 CLI $?)。
        var __sse_exit_code int = 0
        // Plan 055 Phase A.3: SSE 透传的作业事件字段(JobStarted/JobDone
        // 无参 handler 读,对齐 __sse_* 预置模式)。
        var __sse_job_id int = 0
        var __sse_job_cmd str = ""
        var __sse_job_exit int = 0
        var __pending_command_id int = 0
        var __pending_command_str str = ""
    }

    msg Msg { Init, RunCommand(str), RunResult, RunOutput,
              Cancel, RunSmart(int, str, []str), Complete(str, int),
              NavigateHistory(bool), OpenHistorySearch, CloseHistorySearch,
              SelectHistory(str), ToggleSidebar, PickTool(str), RefreshGit, ClearScreen,
              OpenPath(str), DeleteBlock(int), ToggleCollapse(int), RefreshJobs, KillJob(int), JobStarted, JobDone }

    computed {
        // Note: computed uses parse_expr (not parse_body), so complex
        // .field access may overflow. Keep simple for now.
        history => self.persisted_history
        git_label => self.git_label
    }

    on {
        // ── 初始化:拉取 boot 数据 + 历史 + git ──
        .Init -> {
            // cwd 用 "."(当前工作目录)而非 mock 的 /home/user —— M1 执行器
            // 会在此 cwd 执行 std::process::Command,/home/user 在 Windows 无效。
            .cwd = "."
            .home = "."
            // 调 command_list() 拉取侧栏命令表(Plan 044 M2:79 命令,对齐 vue 版)。
            // 路径同 vue:store.Init → command_list → 侧栏 ToolSidebar。
            var snap BootSnapshot = command_list()
            .commands = snap.commands
            .smart_commands = snap.smart_commands
            var names List<str> = List<str>.new([])
            .command_names = names
            // 读真实历史文件(Plan 044 M4:对齐 vue 版 read_history)。
            var hist []str = history()
            .persisted_history = hist
            // APP-05/06:git_label。Init 时调 prompt_context() 获取真实 git 信息
            // (RunResult handler 不会被 renderer 调用 — update_block_in_state
            // 直接在 Rust 侧更新 block,绕过 store handler。故在 Init 拉一次)。
            .git_info = prompt_context()
            .git_label = compute_git_label(.git_info)
            // Plan 055 Phase A: 拉取后台作业列表。
            .job_list = jobs()
        }

        // ── 命令执行 ──
        // Note: VM handler_codegen does not support full `Type{ field: val }`
        // struct literals for state structs ("Undefined variable: self").
        // Build via empty literal + field assignment (verified pattern).
        .RunCommand(cmd) -> {
            // Plan 054 M1:vue/HTTP 模式 store 自己 push Running block(无 renderer
            // 桥) + 发命令到后端。VM 模式 renderer 拦截 RunCommand 构造 block,
            // 此处的 push/run_command 由 VM mock 或 renderer 处理(兼容)。
            var id int = .next_id
            .next_id = .next_id + 1
            var block Block = Block{}
            block.id = id
            block.command = cmd
            block.cwd = .cwd
            var st BlockStatus = BlockStatus{}
            st.kind = "Running"
            st.message = ""
            block.status = st
            block.output = None
            block.streamed_text = ""
            block.duration_ms = 0
            block.exit_code = 0
            block.collapsed = false
            .blocks.push(block)
            // VM renderer 桥接信号(保留 — renderer 读此提交执行器线程)
            .__pending_command_id = id
            .__pending_command_str = cmd
            // HTTP 模式:POST /api/run_command,结果经 /api/stream SSE 推回
            run_command(id, cmd)
        }

        // ── 流式输出块(逐行追加到 Running block) ──
        // M1:无参 handler。renderer 在触发前把 {block_id, chunk} 写入
        // __sse_block_id / __sse_chunk 预置字段(VM 不能收 struct 参)。
        .RunOutput -> {
            for b in .blocks {
                if b.id == .__sse_block_id {
                    b.streamed_text = b.streamed_text + .__sse_chunk
                }
            }
        }

        // ── 命令最终结果 ──
        // M1:无参 handler。renderer 预置 __sse_block_id / __sse_status /
        // __sse_output_text / __sse_duration_ms / __sse_cwd。
        // status 形状:"Success"(裸串)| "Cancelled"(裸串)| {"Failed":msg}(JSON 串)。
        // merged mock 模式 output 为空 —— 用 streamed_text 作 output.Text(执行器
        // 已把 stdout 流式推到 streamed_text)。HTTP 模式 __sse_output_text 带
        // 后端 RenderedOutput.Text。
        .RunResult -> {
            .cwd = .__sse_cwd
            .git_info = prompt_context()
            for b in .blocks {
                if b.id == .__sse_block_id {
                    var st BlockStatus = BlockStatus{}
                    if .__sse_status == "Success" {
                        st.kind = "Success"
                        st.message = ""
                        b.status = st
                        // Plan 052: 优先用 __sse_output(vue 模式 SSE 透传的完整
                        // 结构化 output,可能是 Table/Record/Code/Error/Text)。
                        // 判断"有没有变体":任一变体字段非 None 即说明 SSE 透传了
                        // 完整 output(Table 时 .Text 是 None,故不能只看 .Text)。
                        // (原 `!= RenderedOutput{}` 写法在 .at 解析器下语法错误,
                        //  改为显式 || 变体判断 —— Plan 053 M6 修正。)
                        // VM merged 模式 renderer 不填 __sse_output(所有变体 None),
                        // 走 streamed_text 回退。
                        if .__sse_output.Text != None || .__sse_output.Table != None || .__sse_output.Record != None || .__sse_output.Code != None || .__sse_output.Error != None {
                            b.output = .__sse_output
                        } else {
                            var out RenderedOutput = RenderedOutput{}
                            out.Text = b.streamed_text
                            b.output = out
                        }
                        b.streamed_text = ""
                        b.duration_ms = .__sse_duration_ms
                        b.exit_code = .__sse_exit_code
                    } else {
                        if .__sse_status == "Cancelled" {
                            st.kind = "Cancelled"
                            st.message = ""
                        } else {
                            st.kind = "Failed"
                            // Plan 051 M3 (GAP-B): 失败时 __sse_status 形状是
                            // {"Failed": msg}(externally-tagged 枚举),取 .Failed
                            // 得到错误消息。.__sse_status 类型在 api.at 是 str,
                            // codegen 擦成 any,JS 动态派发 .Failed 可行。
                            st.message = .__sse_status.Failed
                        }
                        b.status = st
                        b.output = None
                        b.streamed_text = ""
                        b.duration_ms = .__sse_duration_ms
                        b.exit_code = .__sse_exit_code
                    }
                }
            }
        }

        // ── 取消(CMD-06:只停首个 Running)──
        // blocks 由 renderer 管理(Value::Array),vm handler 读 .blocks 为 nil,
        // 此 for 循环实际不执行。真正的取消(CMD-06 只停首个 + 进程 kill)在
        // renderer 的 Cancel 拦截里用 Rust 完成。保留此 handler 供非 vm 路径。
        .Cancel -> {
            // Plan 054 M1:HTTP 模式 POST /api/cancel(后端 kill 子进程)。
            // VM 模式 cancel() 是 mock no-op,真取消由 renderer 拦截完成。
            cancel()
            for b in .blocks {
                if b.status.kind == "Running" {
                    var st BlockStatus = BlockStatus{}
                    st.kind = "Cancelled"
                    st.message = ""
                    b.status = st
                }
            }
        }

        // ── SmartCommand ──
        // 镜像手写 runSmartCommand:推一个 Running block,调用 run_smart(返回裸文本),
        // 成功则 output = {Text: result},失败则 status = Failed(message)。
        .RunSmart(block_id, name, args) -> {
            var id int = .next_id
            .next_id = .next_id + 1
            var display str = "smart " + name
            if args.len() > 0 {
                display = display + " " + args.join(" ")
            }
            var block Block = Block{}
            block.id = id
            block.command = display
            block.cwd = .cwd
            var st BlockStatus = BlockStatus{}
            st.kind = "Running"
            st.message = ""
            block.status = st
            block.output = None
            block.streamed_text = ""
            block.duration_ms = 0
            .blocks.push(block)
            var result str = run_smart(id, name, args)
            for b in .blocks {
                if b.id == id {
                    var ok BlockStatus = BlockStatus{}
                    ok.kind = "Success"
                    ok.message = ""
                    b.status = ok
                    var out RenderedOutput = RenderedOutput{}
                    out.Text = result
                    b.output = out
                    b.streamed_text = ""
                }
            }
        }

        // ── 补全(由 PromptBar 调用,返回候选) ──
        .Complete(line, cursor) -> {
            // 补全候选通过 return 值传给调用者
            var items = complete(line, cursor)
            
        }

        // ── 刷新 git 信息 ──
        .RefreshGit -> {
            // Plan 051 M3:经 compute_git_label 安全访问(防 git_status null)。
            .git_label = compute_git_label(.git_info)
        }

        // ── 侧栏 ──
        .ToggleSidebar -> {
            .sidebar_open = !.sidebar_open
        }

        // ── 用 OS 默认程序打开路径(点击表格单元格) ──
        .OpenPath(path) -> {
            open_path(path)
        }

        // ── 清屏(归档所有 blocks) ──
        .ClearScreen -> {
            .blocks = List<Block>.new([])
        }

        // Plan 054 M3: 删除指定 block(按 id 过滤,保留其余)。
        .DeleteBlock(id) -> {
            var kept List<Block> = List<Block>.new([])
            for b in .blocks {
                if b.id != id {
                    kept.push(b)
                }
            }
            .blocks = kept
        }

        // Plan 055 D5: 切换 block 折叠(per-block,避免 VM 单根 state 合并
        // 导致点一个全折叠;vue 模式本就 per-instance,此 handler 两者统一)。
        .ToggleCollapse(id) -> {
            for b in .blocks {
                if b.id == id {
                    b.collapsed = !b.collapsed
                }
            }
        }

        // Plan 055 Phase A: 刷新后台作业列表(轮询;SSE JobStarted/JobDone
        // 实时 dispatch 留 A.3)。RunCommand 后台 `&` 后可手动点标题栏刷新。
        .RefreshJobs -> {
            .job_list = jobs()
        }

        // Plan 055 Phase A: kill 后台作业 + 刷新列表。
        .KillJob(job_id) -> {
            kill_job(job_id)
            .job_list = jobs()
        }

        // Plan 055 Phase A.3: SSE JobStarted/JobDone 实时更新 jobs(无需轮询)。
        // __sse_job_* 由 codegen SSE dispatch 预置(同 RunOutput/RunResult 模式)。
        .JobStarted -> {
            var ji JobInfo = JobInfo{}
            ji.id = .__sse_job_id
            ji.command = .__sse_job_cmd
            ji.state = "Running"
            ji.exit_code = 0
            .job_list.push(ji)
        }

        .JobDone -> {
            // 移除已完成的 job(按 id 过滤,保留其余)。
            var kept List<JobInfo> = List<JobInfo>.new([])
            for j in .job_list {
                if j.id != .__sse_job_id {
                    kept.push(j)
                }
            }
            .job_list = kept
        }
    }
}
