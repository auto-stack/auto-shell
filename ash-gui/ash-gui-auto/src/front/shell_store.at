// front/shell_store.at — Shell 状态管理 store
// Plan 043 M2: 反向生成自 useShellTauri.ts + useShellHttp.ts
//
// 这个 store 封装了 Shell 后端的所有交互:命令执行、补全、历史、流式输出。
// transport 选择(HTTP vs Tauri)不在 .at 里——由 codegen target 决定
// (axum → HTTP fetch,tauri → invoke/listen)。这与 015-notes 的模式一致:
// 同一份 api.at,生成不同 transport 的代码。

use back.api: command_list, complete, run_command, run_smart, prompt_context, history, open_path
use types: Block, BlockStatus, BootSnapshot, CompletionItem, PromptContext, ToolEntry, SmartCommandEntry, CommandResult, CommandOutput, ShellEvent, RenderedOutput

store ShellStore {
    model {
        // ── 核心状态 ──
        var blocks List<Block> = List<Block>.new([])
        var cwd str = ""
        var home str = ""
        var next_id int = 0

        // ── Boot 数据 ──
        var commands List<ToolEntry> = List<ToolEntry>.new([])
        var smart_commands List<SmartCommandEntry> = List<SmartCommandEntry>.new([])
        var command_names []str = []

        // ── 历史持久化 (Plan 040 M6) ──
        var persisted_history []str = []

        // ── Prompt 上下文 (Plan 041 M5: git 分支/状态) ──
        // Note: PromptContext.git_status 类型是 GitStatusInfo(非可选 struct),
        // 不能用 None 默认(parse FieldMismatch)。用一个全零 GitStatusInfo 占位。
        var _gs GitStatusInfo = GitStatusInfo{ staged: 0, unstaged: 0, untracked: 0, conflicted: 0, ahead: 0, behind: 0 }
        var git_info PromptContext = PromptContext{ git_branch: "", git_status: _gs }

        // ── 侧栏开关 ──
        var sidebar_open bool = true
    }

    msg Msg { Init, RunCommand(str), RunResult(CommandResult), RunOutput(CommandOutput),
              Cancel, RunSmart(int, str, []str), Complete(str, int),
              NavigateHistory(bool), OpenHistorySearch, CloseHistorySearch,
              SelectHistory(str), ToggleSidebar, PickTool(str), RefreshGit, ClearScreen,
              OpenPath(str) }

    computed {
        // Note: computed uses parse_expr (not parse_body), so complex
        // .field access may overflow. Keep simple for now.
        history => self.persisted_history
        git_label => ""
    }

    on {
        // ── 初始化:拉取 boot 数据 + 历史 + git ──
        .Init -> {
            var snap BootSnapshot = command_list()
            .cwd = snap.cwd
            .home = snap.home
            .commands = snap.commands
            .smart_commands = snap.smart_commands
            .command_names = []
            for c in snap.commands {
                .command_names.push(c.name)
            }
            .command_names.sort()
            .persisted_history = history()
            .git_info = prompt_context()
        }

        // ── 命令执行 ──
        // Note: VM handler_codegen does not support full `Type{ field: val }`
        // struct literals for state structs ("Undefined variable: self").
        // Build via empty literal + field assignment (verified pattern).
        .RunCommand(cmd) -> {
            var id int = .next_id
            .next_id = .next_id + 1
            var block Block = Block{}
            block.id = id
            block.command = cmd
            block.cwd = .cwd
            var st BlockStatus = BlockStatus{}
            st.kind = "Running"
            st.message = ""
            block.status = st
            block.output = None
            block.streamed_text = ""
            block.duration_ms = 0
            .blocks.push(block)
            run_command(id, cmd)
        }

        // ── 流式输出块(逐行追加到 Running block) ──
        .RunOutput(output) -> {
            for b in .blocks {
                if b.id == output.block_id {
                    b.streamed_text = b.streamed_text + output.chunk
                }
            }
        }

        // ── 命令最终结果 ──
        // status 是 serde 联合:"Success"(裸串)或 {"Failed": msg}(对象)。
        // `result.status == "Success"` 对对象为 false → else 分支取 status.Failed。
        .RunResult(result) -> {
            .cwd = result.cwd
            .git_info = prompt_context()
            for b in .blocks {
                if b.id == result.block_id {
                    var st BlockStatus = BlockStatus{}
                    if result.status == "Success" {
                        st.kind = "Success"
                        st.message = ""
                        b.status = st
                        b.output = result.output
                    } else {
                        st.kind = "Failed"
                        st.message = result.status.Failed
                        b.status = st
                        b.output = None
                    }
                    b.streamed_text = ""
                    b.duration_ms = result.duration_ms
                }
            }
        }

        // ── 取消 ──
        .Cancel -> {
            // cancel() backend call stubbed — diagnosing vm link (M0)
            for b in .blocks {
                if b.status.kind == "Running" {
                    var st BlockStatus = BlockStatus{}
                    st.kind = "Cancelled"
                    st.message = ""
                    b.status = st
                }
            }
        }

        // ── SmartCommand ──
        // 镜像手写 runSmartCommand:推一个 Running block,调用 run_smart(返回裸文本),
        // 成功则 output = {Text: result},失败则 status = Failed(message)。
        .RunSmart(block_id, name, args) -> {
            var id int = .next_id
            .next_id = .next_id + 1
            var display str = "smart " + name
            if args.len() > 0 {
                display = display + " " + args.join(" ")
            }
            var block Block = Block{}
            block.id = id
            block.command = display
            block.cwd = .cwd
            var st BlockStatus = BlockStatus{}
            st.kind = "Running"
            st.message = ""
            block.status = st
            block.output = None
            block.streamed_text = ""
            block.duration_ms = 0
            .blocks.push(block)
            var result str = run_smart(id, name, args)
            for b in .blocks {
                if b.id == id {
                    var ok BlockStatus = BlockStatus{}
                    ok.kind = "Success"
                    ok.message = ""
                    b.status = ok
                    var out RenderedOutput = RenderedOutput{}
                    out.Text = result
                    b.output = out
                    b.streamed_text = ""
                }
            }
        }

        // ── 补全(由 PromptBar 调用,返回候选) ──
        .Complete(line, cursor) -> {
            // 补全候选通过 return 值传给调用者
            var items = complete(line, cursor)
            
        }

        // ── 刷新 git 信息 ──
        .RefreshGit -> {
            .git_info = prompt_context()
        }

        // ── 侧栏 ──
        .ToggleSidebar -> {
            .sidebar_open = !.sidebar_open
        }

        // ── 用 OS 默认程序打开路径(点击表格单元格) ──
        .OpenPath(path) -> {
            open_path(path)
        }

        // ── 清屏(归档所有 blocks) ──
        .ClearScreen -> {
            .blocks = List<Block>.new([])
        }
    }
}
