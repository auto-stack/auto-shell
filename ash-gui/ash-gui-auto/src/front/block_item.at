// front/block_item.at — 单个命令块 widget
// Plan 043 M4: 反向生成自 BlockItem.vue
//
// 一个命令的卡片:头部(❯ command + 状态 + 耗时 + 停止按钮)
// + cwd 行 + 输出主体(BlockBody 分发渲染器)。

use block_body: BlockBody
use types: Block

widget BlockItem(block: Block, home: str, is_latest: bool, on_open_path: msg, on_rerun: msg, on_stop: msg, on_delete: msg, on_toggle_collapse: msg) {
    msg Msg { OpenPath(str), Rerun(str), Stop, CopyCommand(int), CopyOutput(int), ExportCsv(int), DeleteBlock(int), ToggleCollapse(int), Sort(int, int), Filter(str) }

    // Plan 055 D5: collapsed 移到 block 数据(per-block,避免 VM 单根 state
    // 合并致全折叠);model 不再持有折叠状态。

    computed {
        // Plan 053 M6-B2: cwd 缩写(home 前缀 → ~),内联(纯 module fn 文件
        // 不被 codegen 处理)。单层 if/else 规避嵌套 if codegen bug。
        cwd_display => if .home != "" && .block.cwd.starts_with(.home) { "~" + .block.cwd.substr(.home.len(), .block.cwd.len()) } else { .block.cwd }
        status_glyph => if .block.status.kind == "Success" { "✓" } else if .block.status.kind == "Failed" { "✗" } else if .block.status.kind == "Cancelled" { "⊘" } else { "…" }
        status_cls => if .block.status.kind == "Success" { "text-emerald-500" } else if .block.status.kind == "Failed" { "text-red-500" } else { "text-amber-500" }
        // BL-08..10:duration badge。对齐 Vue BlockItem.vue:36-41。
        // < 1000ms 显示 "Nms",否则 "N.Ns"。duration_ms 为 0(Running/未记)时不显示。
        // int 用 .str() 转 str(auto.int.str)再拼接 —— int + str 直接拼接会出错。
        // Plan 053 M6-B1: 拍平为单层 if/else-if/else(worktree 缺 plan-408 嵌套
        // if codegen 修复,嵌套 if 的内层分支会漏 return → undefined)。
        // Plan 055: 简化全 ms(避免 Bina `/1000` receiver 调方法,codegen
        // 对 Bina receiver 不加括号 → `1000.toString()` JS 错)。str() 映射
        // toString(codegen map_method_to_js)。
        duration_label => if .block.duration_ms > 0 { (.block.duration_ms.str() + "ms") } else { "" }
        // Plan 054 M2: 退出码 label + 颜色(非 0 标红,对齐 CLI $?)。
        exit_label => ":" + .block.exit_code.str()
        exit_cls => if .block.exit_code != 0 { "text-red-400" } else { "text-muted-foreground" }
        // Plan 049:折叠指示符。
        collapse_glyph => if .block.collapsed { "▸" } else { "▾" }
    }

    view {
        col {
            // Plan 053 后续:最新块加亮色边框 + 细 ring 区分。基础类走静态 style(→ class);
            // is_latest 高亮走动态 class(→ :class)—— Tailwind 类名必须走 class 通道,
            // 放 style(→ :style)会被当 CSS 声明而失效(这也是上次高亮消失的根因)。
            // is_latest 由 BlockList 传入(末尾块为 true)。
            style: "border-border bg-card/60 px-3 py-2.5 shadow-sm overflow-hidden rounded-lg border"
            class: if .is_latest { "border-sky-400/70 ring-1 ring-sky-400/30" } else { "" }

            // 头部:❯ command + 操作 + 状态(Plan 049:点击折叠/展开)
            // VM 限制:row 元素不支持 onclick(convert_row 会丢弃 events),
            // 而 text 元素带 onclick 会转成无边框 Button(VM 已支持)。
            // 所以把折叠切换挂到折叠指示符 + 命令文本上(点击它们即可折叠)。
            row {
                style: "items-center gap-2 mb-1.5 group cursor-pointer"
                button {
                    onclick: .ToggleCollapse(.block.id)
                    style: "h-6 w-6 bg-transparent rounded flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-white/10"
                    if .block.collapsed {
                        icon {
                            name: "chevron-right"
                            style: "w-4 h-4 text-muted-foreground"
                        }
                    } else {
                        icon {
                            name: "chevron-down"
                            style: "w-4 h-4 text-muted-foreground"
                        }
                    }
                }
                text "❯" {
                    style: "text-muted-foreground select-none"
                }
                text .block.command {
                    style: "font-mono-ash text-sm text-foreground/90 truncate"
                    onclick: .ToggleCollapse
                }

                // 右侧操作区:停止(运行中)+ 悬停显示的复制/重跑 + 状态图标
                // 2026-08-21:hover 背景统一 bg-white/10 —— VM 的 muted 色映射为
                // Surface(与卡片同色),hover:bg-muted/* 叠加后不可见;white/10
                // 两端都可见,且与表头 bg-white/10 的设计语言一致。VM 端由 iced
                // button 的 Status::Hovered 驱动(auto-lang hover: 类支持)。
                row {
                    style: "ml-auto items-center gap-1.5 shrink-0"
                    if .block.status.kind == "Running" {
                        button {
                            onclick: .Stop
                            style: "h-6 w-6 bg-transparent rounded flex items-center justify-center text-red-400 hover:text-red-300 hover:bg-red-500/10"
                            icon {
                                name: "square"
                                style: "w-4 h-4 text-red-400"
                            }
                        }
                    }
                    row {
                        style: "items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity"
                        button {
                            onclick: .CopyCommand(.block.id)
                            style: "h-6 w-6 bg-transparent rounded flex items-center justify-center hover:bg-white/10"
                            icon {
                                name: "copy"
                                style: "w-4 h-4 text-muted-foreground hover:text-foreground"
                            }
                        }
                        // 2026-08-22:复制结果(CopyOutput)从标题栏挪到结果底栏 ——
                        // 命令操作(复制命令/重跑/删除)与结果操作按位置分层,
                        // 图标作用于它附着的东西(见结果底栏注释)。
                        button {
                            onclick: .Rerun(.block.command)
                            style: "h-6 w-6 bg-transparent rounded flex items-center justify-center hover:bg-white/10"
                            icon {
                                name: "rotate-ccw"
                                style: "w-4 h-4 text-muted-foreground hover:text-foreground"
                            }
                        }
                        // Plan 054 M3: 删除此 block(回调父级 store.DeleteBlock)。
                        // 2026-08-21:图标常显红色(危险操作用颜色区分)。VM 端
                        // hover:text-* 经画时着色生效(auto-lang 方案 A:svg::Style
                        // color + 图标自身 Hovered 状态);trash 的 base 与 hover
                        // 只差 alpha(/80 → 全值),而 VM tint 忽略 alpha,悬停时
                        // 图标色不变、按钮背景仍亮起 —— 视觉上够用。
                        button {
                            onclick: .DeleteBlock(.block.id)
                            style: "h-6 w-6 bg-transparent rounded flex items-center justify-center hover:bg-red-500/10"
                            icon {
                                name: "trash-2"
                                style: "w-4 h-4 text-red-400/80 hover:text-red-400"
                            }
                        }
                    }
                    if .block.status.kind == "Success" {
                        icon {
                            name: "check"
                            style: "w-4 h-4 text-emerald-500"
                        }
                    } else {
                        if .block.status.kind == "Failed" {
                            icon {
                                name: "x"
                                style: "w-4 h-4 text-red-500"
                            }
                        } else {
                            if .block.status.kind == "Cancelled" {
                                icon {
                                    name: "x"
                                    style: "w-4 h-4 text-muted-foreground"
                                }
                            } else {
                                icon {
                                    name: "loader"
                                    style: "w-4 h-4 text-amber-500"
                                }
                            }
                        }
                    }
                    // BL-08..10:duration badge(仅完成时 duration_ms > 0 显示)。
                    if .duration_label != "" {
                        text .duration_label {
                            style: "text-[10px] h-5 font-mono-ash text-muted-foreground"
                        }
                    }
                    // Plan 054 M2: 退出码(完成时显示,非 0 标红)。
                    if .block.status.kind == "Success" || .block.status.kind == "Failed" {
                        text .exit_label {
                            // 同上:exit_cls 三元内联(exit_code 非 0 标红)。
                            style: if .block.exit_code != 0 { "text-[10px] h-5 font-mono-ash text-red-400" } else { "text-[10px] h-5 font-mono-ash text-muted-foreground" }
                        }
                    }
                }
            }

            // cwd 行 + 流式 + 输出主体(Plan 049:折叠时隐藏)
            if !.block.collapsed {
                // cwd 行
                if .cwd_display != "" {
                    row {
                        style: "text-[11px] text-muted-foreground/70 font-mono-ash mb-2"
                        icon {
                            name: "folder"
                            style: "w-3.5 h-3.5 text-muted-foreground/70"
                        }
                        text .cwd_display { }
                    }
                }

                // Plan 059:Table 输出走增强表格(排序/过滤/斑马/右对齐/点击
                // 打开);其余变体仍走 BlockBody。排序/过滤状态存 block 字段
                // (table_sort_col/dir/filter_q),VM 由 renderer 直改(同
                // ToggleCollapse 模式),Vue 走 emit → store.SortTable。
                if .block.output.Table != None {
                    // Plan 059:增强表格(排序/过滤/斑马/右对齐/点击打开)。
                    // 内联在 widget view —— view fn 不支持事件(onclick/
                    // oninput 解析报"unsupported event"),事件须解析到
                    // BlockItem 的 msg。ash-table-* 标记类供 vue.rs 注入
                    // 吸顶/列宽拖拽(VM 忽略,无害)。
                    col {
                        style: "max-h-[400px] overflow-y-auto ash-scroll w-full text-sm font-mono-ash border border-border rounded-md bg-card/50"
                        // Plan 059:表头。箭头同行右置恒留位(w-4,未排序列渲染空占位),
                        // 排序态切换不改变表头宽度/高度(此前箭头换行把表头拉高)。背景
                        // bg-white/10(暗色主题下比内容略浅)。block id 事件参数(.block.id)
                        // 经引擎侧回落解析器修复(DEBTS §B8)。
                        row {
                            style: "ash-table-row ash-table-header items-center bg-white/10 border-b border-border display:grid; grid-template-columns: repeat(" + .block.output.Table.columns.len().str() + ", minmax(60px, 1fr))"
                            for ci, cname in .block.output.Table.columns {
                                button {
                                    onclick: .Sort(.block.id, ci)
                                    style: "bg-transparent px-2 py-1 w-full"
                                    row {
                                        style: "items-center gap-1 w-full"
                                        text cname {
                                            style: "flex-1 px-2 py-2 text-left font-semibold text-foreground whitespace-nowrap overflow-hidden text-ellipsis"
                                        }
                                        if .block.table_sort_col == ci {
                                            if .block.table_sort_dir > 0 {
                                                text "▲" {
                                                    style: "w-4 text-right text-[9px] text-sky-400 select-none"
                                                }
                                            } else {
                                                text "▼" {
                                                    style: "w-4 text-right text-[9px] text-sky-400 select-none"
                                                }
                                            }
                                        } else {
                                            text "" {
                                                style: "w-4"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        for idx, row in .block.output.Table.rows {
                            row {
                                style: if idx % 2 == 0 {
                                    "ash-table-row hover:bg-white/[0.03] display:grid; grid-template-columns: repeat(" + .block.output.Table.columns.len().str() + ", minmax(60px, 1fr)); border-b border-border/60 bg-white/5"
                                } else {
                                    "ash-table-row hover:bg-white/[0.03] display:grid; grid-template-columns: repeat(" + .block.output.Table.columns.len().str() + ", minmax(60px, 1fr)); border-b border-border/60"
                                }
                                for cell in row {
                                    if cell.Text != None {
                                        text cell.Text {
                                            style: if cell.Text != "" && "0123456789".contains(cell.Text.substr(0, 1)) {
                                                "px-3 py-1.5 text-right overflow-hidden text-ellipsis whitespace-nowrap text-muted-foreground tabular-nums"
                                            } else {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap text-muted-foreground"
                                            }
                                        }
                                    }
                                    if cell.Tagged != None {
                                        text cell.Tagged.text {
                                            onclick: .OpenPath(cell.Tagged.text)
                                            style: if cell.Tagged.kind == "Dir" {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-sky-400"
                                            } else if cell.Tagged.kind == "CodeAtRs" {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-emerald-400"
                                            } else if cell.Tagged.kind == "Executable" {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-cyan-300"
                                            } else if cell.Tagged.kind == "Config" {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-amber-300"
                                            } else if cell.Tagged.kind == "Permission" {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-muted-foreground"
                                            } else {
                                                "px-3 py-1.5 text-left overflow-hidden text-ellipsis whitespace-nowrap cursor-pointer hover:underline text-foreground"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 流式输出(运行中时显示)
                if .block.status.kind == "Running" && .block.streamed_text != "" {
                    // Plan 053 后续:长输出限高 + 原生 overflow + .ash-scroll(AutoUI 风格
                    // 细/半透明滚动条,见 index.css)。不用 reka-ui scroll——其 bar 需确定
                    // 高度检测溢出,与 max-h(限高)不兼容会致 bar 看不见。
                    col {
                        style: "max-h-[400px] overflow-y-auto ash-scroll mb-2"
                        text .block.streamed_text {
                            style: "text-xs font-mono-ash text-foreground/80 whitespace-pre-wrap"
                        }
                    }
                }

                // 输出主体—— Plan 053 后续:show/cat 等长结果限高 max-h-[400px],超出在
                // block 内部滚动。用原生 overflow-y-auto + .ash-scroll(AutoUI 风格滚动条),
                // 不用 reka-ui scroll(其 bar 与 max-h 不兼容)。
                // Plan 059:Table 变体已在上文 RenderTable 直渲染,此处只走非 Table。
                // VM 缺陷规避(2026-08-21):BlockBody 是子 widget,其 output prop 的
                // .Text 字段在 iced VM 读成空(子 widget prop 字段访问 bug),导致
                // pwd/echo 等 Text 输出整体空白。Text 在此内联渲染(同上方 Table
                // 内联—— .block.output 字段访问在父 widget 正常),非 Text/Table
                // 变体才落 BlockBody。Vue 端同理受益(BlockBody 对 Text 不再重复渲染)。
                if .block.output.Text != None {
                    text .block.output.Text {
                        style: "text-sm font-mono-ash text-foreground/90 whitespace-pre-wrap break-words"
                    }
                }
                if .block.output != None {
                    if .block.output.Table == None && .block.output.Text == None {
                        col {
                            style: "max-h-[400px] overflow-y-auto ash-scroll"
                            BlockBody(output: .block.output, on_open_path: .OpenPath)
                        }
                    }
                }

                // 2026-08-22:结果底栏 —— 结果级操作贴着结果本身。复制结果与
                // 复制命令按**位置**区分而非图标区分:标题栏 = 命令操作(复制
                // 命令/重跑/删除),底栏 = 结果操作。接近性优于同形图标微调 ——
                // 16px 灰阶下 copy/clipboard 系图标几乎不可辨,而位置语义零学习
                // 成本(GitHub/VS Code 代码块 copy 按钮同款模式)。仅 Text/Table
                // 有可复制内容时显示(CopyOutput/ExportCsv 目前只支持这两变体;
                // Code/Error 落 BlockBody,接入后放开)。图标小一档
                // (w-3.5 vs 标题栏 w-4)标记次级操作。
                // 按钮语义:copy = 复制结果(Text 原文 / Table TSV,TSV 直贴
                // Excel/Sheets 自动分列);table = 导出 CSV(引号转义,Excel 可
                // 直接打开)—— 2026-08-22 续:table 图标从标题栏下沉至此。
                if .block.output.Text != None || .block.output.Table != None {
                    row {
                        style: "justify-end items-center gap-1 mt-1"
                        button {
                            onclick: .CopyOutput(.block.id)
                            style: "h-5 w-5 bg-transparent rounded flex items-center justify-center hover:bg-white/10"
                            icon {
                                name: "copy"
                                style: "w-3.5 h-3.5 text-muted-foreground/80 hover:text-foreground"
                            }
                        }
                        if .block.output.Table != None {
                            button {
                                onclick: .ExportCsv(.block.id)
                                style: "h-5 w-5 bg-transparent rounded flex items-center justify-center hover:bg-white/10"
                                icon {
                                    name: "table"
                                    style: "w-3.5 h-3.5 text-muted-foreground/80 hover:text-foreground"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Stop -> { }
        // Plan 055 D5: 折叠回调(空 handler — renderer emit on_toggle_collapse(id)
        // 给父级,由 store.ToggleCollapse 翻 blocks[id].collapsed)。
        .ToggleCollapse(id) -> { }
        .Rerun(cmd) -> { }
        // 复制命令到剪贴板(navigator API 由 ts_adapter 透传)
        // Plan 053 M6-B3: 非安全上下文(http)navigator.clipboard 可能不可用,
        // 加 != null 守卫避免抛异常(loose null check 覆盖 null/undefined)。
        .CopyCommand(id int) -> {
            if navigator.clipboard != null {
                navigator.clipboard.writeText(.block.command)
            }
        }
        // Plan 054 M3 → 2026-08-22 结果底栏版:CopyOutput = 复制结果 ——
        // Text 变体复制原文;Table 变体复制 TSV(制表符分隔,直贴 Excel/
        // Sheets 自动分列,不做引号转义)。CSV 导出拆到 ExportCsv(table
        // 图标,语义:文件交换格式,引号转义 + Excel 可直接打开)。
        // Vue 端经 navigator.clipboard;VM 端 navigator 不存在(handler
        // 在 guard 静默中止),由 renderer 桥 arboard 写系统剪贴板
        // (桥侧同语义:CopyOutput→Text/TSV,ExportCsv→CSV)。
        .CopyOutput(id int) -> {
            if navigator.clipboard != null {
                if .block.output.Text != None {
                    navigator.clipboard.writeText(.block.output.Text)
                } else {
                    if .block.output.Table != None {
                        var tsv str = ""
                        var t = .block.output.Table
                        var hi int = 0
                        for hi < t.columns.len() {
                            if hi > 0 {
                                tsv = tsv + "\t"
                            }
                            tsv = tsv + t.columns[hi]
                            hi = hi + 1
                        }
                        var ri int = 0
                        for ri < t.rows.len() {
                            var row = t.rows[ri]
                            var line str = ""
                            var ci int = 0
                            for ci < row.len() {
                                var cell = row[ci]
                                var txt str = ""
                                if cell.Text != None {
                                    txt = cell.Text
                                } else {
                                    txt = cell.Tagged.text
                                }
                                if ci > 0 {
                                    line = line + "\t"
                                }
                                line = line + txt
                                ci = ci + 1
                            }
                            tsv = tsv + "\n" + line
                            ri = ri + 1
                        }
                        navigator.clipboard.writeText(tsv)
                    }
                }
            }
        }
        // 2026-08-22:CSV 导出(table 图标,Plan 059 的 CSV 逻辑从 CopyOutput
        // 迁来:引号加倍,含分隔符/换行加引号)。
        .ExportCsv(id int) -> {
            if navigator.clipboard != null {
                if .block.output.Table != None {
                    var csv str = ""
                    var t = .block.output.Table
                    var hi int = 0
                    for hi < t.columns.len() {
                        if hi > 0 {
                            csv = csv + ","
                        }
                        csv = csv + t.columns[hi]
                        hi = hi + 1
                    }
                    var ri int = 0
                    for ri < t.rows.len() {
                        var row = t.rows[ri]
                        var line str = ""
                        var ci int = 0
                        for ci < row.len() {
                            var cell = row[ci]
                            var txt str = ""
                            if cell.Text != None {
                                txt = cell.Text
                            } else {
                                txt = cell.Tagged.text
                            }
                            if txt.contains(",") || txt.contains("\"") || txt.contains("\n") {
                                txt = "\"" + txt.replace("\"", "\"\"") + "\""
                            }
                            if ci > 0 {
                                line = line + ","
                            }
                            line = line + txt
                            ci = ci + 1
                        }
                        csv = csv + "\n" + line
                        ri = ri + 1
                    }
                    navigator.clipboard.writeText(csv)
                }
            }
        }
        // Plan 054 M3: 删除回调(空 handler — renderer emit on_delete 给父级)。
        .DeleteBlock(id) -> { }
        .OpenPath(path) -> { }
    }
}


