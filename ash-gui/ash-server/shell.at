// back/shell.at — Plan 060 M3:merged 模式宿主桥桩(零后端逻辑)
//
// 架构(对齐 015-notes 双模式 / docs/plans/060 §M3):
//   HTTP 模式:api.at 裸调用被 codegen 改写为 fetch → ash-server →
//     worker(auto_shell::Shell)→ ash-core;本文件不被执行。
//   merged 模式(ash-runner 启动):api.at 的实现体调本桩,本桩经
//     auto.host.call / auto.host.call_value 直调 runner 注册的桥函数
//     (同一 worker/Shell/ash-core,进程内、无 socket)—— 两种模式
//     共享同一份后端实现,语义零分叉。
//
// 历史:此文件曾是 891 行的 .at mock 后端(79 命令表/ls/cd/pwd/show
// 语义 + JSON 拼装),与 ash-core 反复漂移(ls 分类、show 高亮均出过
// 不一致),且 .at 拼巨串触发过 VM 字符串堆损坏 —— M3 全部退役,
// 仅保留 pub fn 签名供 api.at 的 `use shell` 编译解析。
//
// 惯例:参数经 json.encode 序列化(与 HTTP body 同构);返回经
// host.call_value 直接转换成 VM 值(复用 HTTP 模式 json.to_value 管线)。
// int 拼 str 一律 .str()(VM 直拼会出错)。

use types: BootSnapshot, CompletionItem, GitStatusInfo, PromptContext, ShellEvent, ToolEntry, SmartCommandEntry, JobInfo, RenderedOutput

pub fn command_list() BootSnapshot {
    // spike 候选 a:JSON 串 + .at 侧 json.to_value(HTTP 模式同构)
    return json.to_value(host.call("command_list", "{}"))
}

pub fn read_history() []str {
    return host.call_value("history", "{}")
}

pub fn complete(line str, cursor int) []CompletionItem {
    return host.call_value("complete", "{\"line\":" + json.encode(line) + ",\"cursor\":" + cursor.str() + "}")
}

pub fn prompt_context() PromptContext {
    return host.call_value("prompt_context", "{}")
}

pub fn run_command(block_id int, cmd str, cwd str) {
    // cwd 参数为 HTTP 契约兼容字段:worker 的 Shell 自管会话 cwd
    // (与 ash-server 忽略 body.cwd 同语义)。
    host.call("run_command", "{\"block_id\":" + block_id.str() + ",\"cmd\":" + json.encode(cmd) + "}")
}

pub fn run_smart(block_id int, name str, args []str) str {
    // HTTP 模式此端点返回 Json(result.output)(裸文本);merged 对齐:
    // 桥返回 SmartResult{output,error},此处取 output(错误时给 error)。
    var args_json str = "["
    var i int = 0
    for i < args.len() {
        if i > 0 {
            args_json = args_json + ","
        }
        args_json = args_json + json.encode(args[i])
        i = i + 1
    }
    args_json = args_json + "]"
    var r = host.call_value("run_smart", "{\"block_id\":" + block_id.str() + ",\"name\":" + json.encode(name) + ",\"args\":" + args_json + "}")
    if r.error != "" {
        return r.error
    }
    return r.output
}

pub fn cancel() {
    host.call("cancel", "{}")
}

pub fn open_path(path str) {
    host.call("open_path", "{\"path\":" + json.encode(path) + "}")
}

pub fn jobs() []JobInfo {
    return host.call_value("jobs", "{}")
}

pub fn kill_job(job_id int) {
    host.call("kill_job", "{\"job_id\":" + job_id.str() + "}")
}

// Plan 062 T11:NL→命令翻译(同步契约端点;返回裸 JSON 字符串)。
pub fn nl2cmd(nl str) str {
    return host.call_value("nl2cmd", "{\"nl\":" + json.encode(nl) + "}")
}

// Plan 062 T11:待回填的 AI 建议命令(取后即清;空串 = 无)。
pub fn ai_pending() str {
    return host.call_value("ai_pending", "{}")
}

// merged-host 模式:事件由 runner 的 ShellEvent 广播经
// auto_lang::inject_shell_event 直接注入前端事件泵(SSE 同格式),
// 不消费此流。HTTP 模式:真实 SSE 由 ash-server /api/stream 提供。
// 注:`~Stream<ShellEvent>` 是类型注解(vue codegen 据此生成
// EventSource),VM 当普通函数、不返回 Stream 值(同旧桩)。
pub fn subscribe() ~Stream<ShellEvent> {
}
