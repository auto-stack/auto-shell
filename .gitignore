# Rust build artifacts — each workspace (ash/, ash-gui/...) has its own target/
/target/
**/target/

# Binaries / build output
*.exe
*.pdb

# Editor / OS cruft
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Note: Cargo.lock IS committed — these are binary crates (ash, ash-gui),
# where lockfiles should be tracked.
# Exception: ash-core/Cargo.lock is NOT tracked — ash-core is consumed as
# a path dependency (a library), so the lockfile is a build-time artifact.
/ash-core/Cargo.lock

# Local scratch/scratch files for manual testing
**/tmp/

# auto-man / AutoCache runtime state (per-project, regenerated on codegen)
**/.am/

# auto-lang codegen output for ash-gui-auto (regenerated by `auto gen`;
# 015-notes commits its gen/, but here gen/ is a verification artifact for
# Plan 043 M5, currently partial — regenerate before use, don't commit)
ash-gui/ash-gui-auto/gen/

# Git worktrees (isolated workspaces for feature branches)
/.worktrees/

# ZCode session cache (per-session plan artifacts — not project content)
/.zcode/
